<div class="tbe-sheet-body tbe-npc-body">
  <header class="tbe-header"><button type="button" class="tbe-portrait" data-portrait title="Choose picture"><img src="{{actor.img}}" alt="{{actor.name}}" width="72" height="72"></button><label class="tbe-header-name">NPC / creature name <input name="name" value="{{actor.name}}"></label><label class="tbe-header-concept">Description <textarea name="system.description" rows="2">{{system.description}}</textarea></label></header>
  <section><h2>PROFILE</h2><div class="tbe-npc-fields"><label>Difficulty <input name="system.difficulty" value="{{system.difficulty}}"></label><label>Size <input name="system.size" value="{{system.size}}"></label><label>Initiative <input name="system.initiative" value="{{system.initiative}}"></label><label>Move <input name="system.move" value="{{system.move}}"></label><label>Ferocity <input type="number" name="system.ferocity" value="{{system.ferocity}}"></label><label>Toughness <input name="system.toughness" value="{{system.toughness}}"></label><label>Death Threshold <input type="number" name="system.deathThreshold" value="{{system.deathThreshold}}"></label><label>Resolve <input type="number" name="system.resolve.value" value="{{system.resolve.value}}" title="Most NPCs do not track Resolve; use this for exceptional creatures."></label><label>Max Resolve <input type="number" name="system.resolve.max" value="{{system.resolve.max}}"></label></div><small>Most NPCs use static Initiative and do not track Resolve. Use the Resolve fields for exceptions.</small></section>
  <section><h2>WOUNDS &amp; PROTECTION</h2><div class="tbe-npc-summary"><b>Location</b><b>Armour AP</b><b>L WP</b><b>NL WP</b>{{#each summary as |row|}}<span>{{row.location}}</span><span>{{row.ap}}</span><strong>{{row.lethal}}</strong><strong>{{row.nonlethal}}</strong>{{/each}}</div><p><b>Total lethal WP:</b> {{totalLethal}} / DT {{system.deathThreshold}} · <b>Nonlethal WP:</b> {{totalNonlethal}}</p><h3>Armour by location <button type="button" data-npc-add="protection">+ Armour</button></h3><div class="tbe-npc-rows">{{#each system.protection as |row i|}}<div class="tbe-npc-row tbe-npc-protection"><label>Location <input name="system.protection.{{i}}.location" value="{{row.location}}" list="tbe-npc-locations"></label><label>AP <input name="system.protection.{{i}}.ap" value="{{row.ap}}" title="Preserve shield AP separately, e.g. 4+3"></label><label>Notes <input name="system.protection.{{i}}.notes" value="{{row.notes}}"></label><button type="button" data-npc-remove="protection:{{i}}" title="Delete protection">×</button></div>{{/each}}</div><h3>Wounds <button type="button" data-npc-add="wounds">+ Wound</button></h3><div class="tbe-npc-rows">{{#each system.wounds as |row i|}}<div class="tbe-npc-row tbe-npc-wound"><label>Location <input name="system.wounds.{{i}}.location" value="{{row.location}}" list="tbe-npc-locations"></label><label>WP <input type="number" min="0" name="system.wounds.{{i}}.points" value="{{row.points}}"></label><label>Type <select name="system.wounds.{{i}}.lethal"><option value="true" {{#if row.lethal}}selected{{/if}}>Lethal</option><option value="false" {{#unless row.lethal}}selected{{/unless}}>Nonlethal</option></select></label><label>Injury <input name="system.wounds.{{i}}.detail" value="{{row.detail}}"></label><button type="button" data-npc-remove="wounds:{{i}}" title="Delete wound">×</button></div>{{/each}}</div></section>
  <section><h2>SKILLS &amp; ATTACKS</h2><h3>Skills <button type="button" data-npc-add="skills">+ Skill</button></h3><div class="tbe-npc-rows">{{#each system.skills as |row i|}}<div class="tbe-npc-row tbe-npc-skill"><label>Skill <input name="system.skills.{{i}}.name" value="{{row.name}}"></label><label>Target % <input type="number" name="system.skills.{{i}}.value" value="{{row.value}}"></label><label>Ex <input type="number" min="0" name="system.skills.{{i}}.expertise" value="{{row.expertise}}"></label><button type="button" data-npc-roll="skills:{{i}}" title="Roll skill">Roll</button><button type="button" data-npc-remove="skills:{{i}}" title="Delete skill">×</button></div>{{/each}}</div><h3>Weapons &amp; special attacks <button type="button" data-npc-add="attacks">+ Attack</button></h3><div class="tbe-npc-rows">{{#each system.attacks as |row i|}}<div class="tbe-npc-attack"><div class="tbe-npc-row tbe-npc-skill"><label>Attack <input name="system.attacks.{{i}}.name" value="{{row.name}}"></label><label>Target % <input type="number" name="system.attacks.{{i}}.value" value="{{row.value}}"></label><label>Ex <input type="number" min="0" name="system.attacks.{{i}}.expertise" value="{{row.expertise}}"></label><button type="button" data-npc-roll="attacks:{{i}}">Attack</button><button type="button" data-npc-remove="attacks:{{i}}" title="Delete attack">×</button></div><div class="tbe-npc-fields"><label>Damage <input name="system.attacks.{{i}}.damage" value="{{row.damage}}"></label><label>Reach <input name="system.attacks.{{i}}.reach" value="{{row.reach}}"></label><label>Range <input name="system.attacks.{{i}}.range" value="{{row.range}}"></label><label>Manoeuvres / special rules <input name="system.attacks.{{i}}.notes" value="{{row.notes}}"></label></div></div>{{/each}}</div></section>
  <section><h2>SPECIAL ABILITIES &amp; TALENTS</h2><button type="button" data-npc-add="abilities">+ Ability</button><div class="tbe-npc-rows">{{#each system.abilities as |row i|}}<div class="tbe-npc-ability"><div class="tbe-npc-row"><label>Ability / talent <input name="system.abilities.{{i}}.name" value="{{row.name}}"></label><button type="button" data-npc-remove="abilities:{{i}}" title="Delete ability">×</button></div><textarea name="system.abilities.{{i}}.effect" rows="2">{{row.effect}}</textarea></div>{{/each}}</div></section>
  <section><h2>GM NOTES &amp; SOURCE</h2><label>Reference <input name="system.reference" value="{{system.reference}}"></label><label>Notes and tactics <textarea name="system.notes" rows="5">{{system.notes}}</textarea></label><details><summary>Original printed stat block (for checking extraction)</summary><textarea name="system.rawStatblock" rows="15">{{system.rawStatblock}}</textarea></details></section>
  <datalist id="tbe-npc-locations">{{#each locations as |location|}}<option value="{{location}}"></option>{{/each}}</datalist>
</div>
