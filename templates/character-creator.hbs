<div class="tbe-creator-body">
  <header><span>Step {{step}} of {{count}}</span><h2>{{title}}</h2></header>
  <div class="tbe-creator-content">{{{body}}}</div>
  <footer>
    {{#unless first}}<button type="button" data-back>← Back</button>{{/unless}}
    <span>Closing this window resets the draft.</span>
    {{#if last}}<button type="button" data-finish>Finish character</button>{{else}}<button type="button" data-next>Next →</button>{{/if}}
  </footer>
</div>
