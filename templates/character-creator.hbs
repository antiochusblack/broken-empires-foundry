<div class="tbe-creator-body">
  <header><div><span>Step {{step}} of {{count}}</span><h2>{{title}}</h2></div><button type="button" data-toggle-skills aria-expanded="{{previewOpen}}">{{#if previewOpen}}Hide skills{{else}}Show skills{{/if}}</button></header>
  <div class="tbe-creator-main">
    <div class="tbe-creator-content">{{{guidance}}}{{{body}}}</div>
  </div>
  <footer>
    {{#unless first}}<button type="button" data-back>← Back</button>{{/unless}}
    {{#if pointsTracker}}<strong data-points-tracker>{{pointsTracker}}</strong>{{/if}}
    <span>Closing this window resets the draft.</span>
    {{#if last}}<button type="button" data-finish>Finish character</button>{{else}}<button type="button" data-next>Next →</button>{{/if}}
  </footer>
</div>
