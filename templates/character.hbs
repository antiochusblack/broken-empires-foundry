<div class="tbe-sheet-body">
  <header class="tbe-header"><img src="{{document.img}}" alt="{{document.name}}" width="72" height="72"><label>Character name <input name="name" value="{{document.name}}"></label><label>Concept <input name="system.description" value="{{system.description}}"></label></header>
  <nav class="tbe-nav" aria-label="Character sections"><button type="button" data-section="identity">Identity</button><button type="button" data-section="skills">Skills</button><button type="button" data-section="magic">Magic</button><button type="button" data-section="combat">Combat</button><button type="button" data-section="story">Story</button><button type="button" data-section="gear">Gear</button></nav>
  <section id="tbe-identity"><h2>Identity & creation</h2><div class="tbe-grid">
    <label>Race <input name="system.race" value="{{system.race}}"></label><label>Sex <input name="system.sex" value="{{system.sex}}"></label><label>Size <input name="system.size" value="{{system.size}}"></label><label>Age <input name="system.age" value="{{system.age}}"></label>
    <label>Culture <input name="system.culture" value="{{system.culture}}"></label><label>Previous career <input name="system.career" value="{{system.career}}"></label><label>Status <input type="number" name="system.status" value="{{system.status}}"></label><label>XP <input type="number" name="system.xp" value="{{system.xp}}"></label>
  </div>
  <h3>Ability scores & descriptors <button type="button" data-add="abilityScores">Add</button></h3><div class="tbe-list tbe-abilities"><div class="tbe-list-heading"><span>Ability score</span><span>Descriptor</span><span></span></div>{{#each system.abilityScores as |row i|}}<div class="tbe-list-row"><input aria-label="Ability score" placeholder="STR, DEX, CON, INT, WIS or CHA" name="system.abilityScores.{{i}}.name" value="{{row.name}}"><input aria-label="Descriptor" placeholder="Descriptor" name="system.abilityScores.{{i}}.descriptor" value="{{row.descriptor}}"><button type="button" data-remove="abilityScores:{{i}}">Remove</button></div>{{/each}}</div>
  <h3>Race traits <button type="button" data-add="racialTraits">Add</button></h3><div class="tbe-list tbe-traits"><div class="tbe-list-heading"><span>Trait</span><span>Effect</span><span></span></div>{{#each system.racialTraits as |row i|}}<div class="tbe-list-row"><input aria-label="Trait" placeholder="Trait" name="system.racialTraits.{{i}}.name" value="{{row.name}}"><textarea class="tbe-grow" rows="1" aria-label="Effect" placeholder="Effect" name="system.racialTraits.{{i}}.effect">{{row.effect}}</textarea><button type="button" data-remove="racialTraits:{{i}}">Remove</button></div>{{/each}}</div>
  </section>
  <section id="tbe-skills"><h2>Skills</h2><p>Edit values directly after making your character creation choices. Ex is Expertise; S marks Savvy.</p>
  {{#each skillGroups as |group|}}{{#unless (eq group.category "Strands")}}{{#unless (eq group.category "Binds")}}{{#unless (eq group.category "Magic")}}<h3>{{group.category}}</h3><div class="tbe-skill-head"><span>Skill</span><span>%</span><span>Ex</span><span>S</span></div><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span>{{row.name}}</span><input aria-label="{{row.name}} percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><input aria-label="{{row.name}} Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"><label class="tbe-check">S <input type="checkbox" name="{{row.path}}.savvy" {{#if row.data.savvy}}checked{{/if}}></label></div>{{/each}}</div>{{/unless}}{{/unless}}{{/unless}}{{/each}}
  <h3>Languages, custom -wise and other skills <button type="button" data-add="customSkills">Add custom skill</button></h3><div class="tbe-list tbe-custom-table"><div class="tbe-list-heading"><span>Skill</span><span>Category</span><span>%</span><span>Ex</span><span>Savvy</span><span></span></div>{{#each system.customSkills as |row i|}}<div class="tbe-list-row"><input aria-label="Skill name" placeholder="Skill name" name="system.customSkills.{{i}}.name" value="{{row.name}}"><input aria-label="Category" placeholder="Category" name="system.customSkills.{{i}}.category" value="{{row.category}}"><input aria-label="Percent" type="number" name="system.customSkills.{{i}}.value" value="{{row.value}}"><input aria-label="Expertise" type="number" name="system.customSkills.{{i}}.expertise" value="{{row.expertise}}"><label class="tbe-check"><input aria-label="Savvy" type="checkbox" name="system.customSkills.{{i}}.savvy" {{#if row.savvy}}checked{{/if}}></label><button type="button" data-remove="customSkills:{{i}}">×</button></div>{{/each}}</div></section>
  <section id="tbe-magic"><h2>Magic</h2>{{#each skillGroups as |group|}}{{#if (eq group.category "Binds")}}<h3>Binds</h3><div class="tbe-skill-head"><span>Bind</span><span>%</span><span>Ex</span><span>S</span></div><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span>{{row.name}}</span><input aria-label="{{row.name}} percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><input aria-label="{{row.name}} Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"><label class="tbe-check">S <input type="checkbox" name="{{row.path}}.savvy" {{#if row.data.savvy}}checked{{/if}}></label></div>{{/each}}</div>{{/if}}
  {{#if (eq group.category "Magic")}}<h3>Piety</h3><div class="tbe-skill-head"><span>Skill</span><span>%</span><span>Ex</span><span></span></div><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill tbe-skill-piety"><span>{{row.name}}</span><input aria-label="Piety percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><input aria-label="Piety Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"></div>{{/each}}</div>{{/if}}
  {{#if (eq group.category "Strands")}}<h3>Strands</h3><div class="tbe-skill-head"><span>Strand</span><span>Level</span><span>Thin</span><span></span></div><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill tbe-skill-strand"><span>{{row.name}}</span><input aria-label="{{row.name}} level" type="number" name="{{row.path}}.level" value="{{row.data.level}}"><label class="tbe-check"><input aria-label="Thin Strand" type="checkbox" name="{{row.path}}.thin" {{#if row.data.thin}}checked{{/if}}></label></div>{{/each}}</div>{{/if}}{{/each}}
  <div class="tbe-grid"><label>True Name <input name="system.trueName" value="{{system.trueName}}"></label><label>Threads <input name="system.threads" value="{{system.threads}}"></label><label>Fraying <input type="number" name="system.fraying" value="{{system.fraying}}"></label></div></section>
  <section id="tbe-combat"><h2>Resolve, fatigue & attributes</h2><div class="tbe-grid">
  <label>Current Resolve <input type="number" name="system.resolve.value" value="{{system.resolve.value}}"></label><label>Maximum Resolve <input type="number" name="system.resolve.max" value="{{system.resolve.max}}"></label><label>Fatigue <input type="number" name="system.resolve.fatigue" value="{{system.resolve.fatigue}}"></label><label>Permanent fatigue <input type="number" name="system.resolve.permanentFatigue" value="{{system.resolve.permanentFatigue}}"></label>
  <label>Initiative <input type="number" name="system.attributes.initiative" value="{{system.attributes.initiative}}"></label><label>Initiative penalty <input type="number" name="system.attributes.initiativePenalty" value="{{system.attributes.initiativePenalty}}"></label><label>Toughness <input type="number" name="system.attributes.toughness" value="{{system.attributes.toughness}}"></label><label>Death Threshold <input type="number" name="system.attributes.deathThreshold" value="{{system.attributes.deathThreshold}}"></label><label>Lethality Level <input type="number" name="system.attributes.lethalityLevel" value="{{system.attributes.lethalityLevel}}"></label></div>
  <h3>Wounds <button type="button" data-add="wounds">Add wound</button></h3>
  <p>Lethality Level (LL) and Death Threshold apply to the character’s <strong>total lethal WP</strong>, not to a separate limit on each limb. Location WP (L + NL) is used for impairment.</p>
  <div class="tbe-wound-overall"><div><b>Total lethal WP</b><span>{{totalLethalWP}} / LL {{ll}}</span></div><div><b>Total nonlethal WP</b><span>{{totalNonlethalWP}}</span></div><div><b>Death Threshold</b><span>{{system.attributes.deathThreshold}}</span></div></div>
  <div class="tbe-wound-summary"><div class="tbe-wound-summary-row tbe-wound-summary-heading"><span>Location</span><span>L WP</span><span>NL WP</span><span>LL (global)</span></div>{{#each woundSummary as |slot|}}<div class="tbe-wound-summary-row"><b>{{slot.location}}</b><span>{{slot.lethal}}</span><span>{{slot.nonlethal}}</span><span>{{slot.ll}}</span></div>{{/each}}</div>
  {{#if unassignedWounds.length}}<p class="tbe-over">Some wounds have WP but no recognised general location. Choose a location on each wound below to include it in the location summary.</p>{{/if}}
  <div class="tbe-wound-cards">{{#each system.wounds as |row i|}}<div class="tbe-wound-card">
    <div class="tbe-wound-fields"><label>General location <select name="system.wounds.{{i}}.generalLocation"><option value="">Choose location</option><option value="Head" {{#if (eq row.generalLocation "Head")}}selected{{/if}}>Head</option><option value="Body" {{#if (eq row.generalLocation "Body")}}selected{{/if}}>Body</option><option value="Right Arm" {{#if (eq row.generalLocation "Right Arm")}}selected{{/if}}>Right Arm</option><option value="Left Arm" {{#if (eq row.generalLocation "Left Arm")}}selected{{/if}}>Left Arm</option><option value="Right Leg" {{#if (eq row.generalLocation "Right Leg")}}selected{{/if}}>Right Leg</option><option value="Left Leg" {{#if (eq row.generalLocation "Left Leg")}}selected{{/if}}>Left Leg</option></select></label>
    <label>Detailed location <input placeholder="e.g. right forearm" name="system.wounds.{{i}}.location" value="{{row.location}}"></label>
    <label>Injury <textarea class="tbe-grow" rows="1" name="system.wounds.{{i}}.detail">{{row.detail}}</textarea></label>
    <label>WP <input type="number" min="0" name="system.wounds.{{i}}.points" value="{{row.points}}"></label></div>
    <div class="tbe-wound-flags"><label class="tbe-check">Lethal (uncheck for NL) <input type="checkbox" name="system.wounds.{{i}}.lethal" {{#if row.lethal}}checked{{/if}}></label><label class="tbe-check">Ritual <input type="checkbox" name="system.wounds.{{i}}.ritual" {{#if row.ritual}}checked{{/if}}></label><label class="tbe-check">Infected <input type="checkbox" name="system.wounds.{{i}}.infection" {{#if row.infection}}checked{{/if}}></label><label class="tbe-check">Septic <input type="checkbox" name="system.wounds.{{i}}.septic" {{#if row.septic}}checked{{/if}}></label><button type="button" data-remove="wounds:{{i}}">Remove wound</button></div>
  </div>{{/each}}</div>
  <label>Sepsis deadline (in game; 48 hours from onset) <input name="system.sepsisDeadline" value="{{system.sepsisDeadline}}" placeholder="e.g. Tomorrow at sundown"></label>
  <h3>Custom resources <button type="button" data-add="resources">Add resource</button></h3><div class="tbe-list tbe-resources"><div class="tbe-list-heading"><span>Resource</span><span>Current</span><span></span><span>Maximum</span><span></span></div>{{#each system.resources as |row i|}}<div class="tbe-list-row"><input placeholder="Resource name" aria-label="Resource name" name="system.resources.{{i}}.name" value="{{row.name}}"><input aria-label="Current" type="number" name="system.resources.{{i}}.value" value="{{row.value}}"><span>/</span><input aria-label="Maximum" type="number" name="system.resources.{{i}}.max" value="{{row.max}}"><button type="button" data-remove="resources:{{i}}">×</button></div>{{/each}}</div>
  <h3>Talents <button type="button" data-add="talent">Add talent</button></h3><p>Click a talent to edit its details, or drag one here from the Items sidebar.</p><div class="tbe-talent-cards">{{#each talents as |item|}}<div class="tbe-talent-card" draggable="true" data-item-id="{{item.id}}">
    <div class="tbe-talent-title"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">{{item.name}}</button>{{#if @root.isGM}}<button type="button" title="Copy to Items Directory" data-copy-item="{{item.id}}">Copy to Items</button>{{/if}}<button type="button" aria-label="Remove {{item.name}}" data-delete-item="{{item.id}}">×</button></div>
    {{#if item.system.source}}<div class="tbe-talent-detail"><b>Source</b><span>{{item.system.source}}</span></div>{{/if}}
    {{#if item.system.effect}}<div class="tbe-talent-detail"><b>Effect</b><span>{{item.system.effect}}</span></div>{{/if}}
    {{#if item.system.requirements}}<div class="tbe-talent-detail"><b>Requirements</b><span>{{item.system.requirements}}</span></div>{{/if}}
  </div>{{/each}}</div>
  </section>
  <section id="tbe-story"><h2>Life events</h2><div class="tbe-grid">{{#each system.events as |event name|}}<div class="tbe-event"><h3>{{name}}</h3><label>Event <input name="system.events.{{name}}.name" value="{{event.name}}"></label><label>Benefit <input name="system.events.{{name}}.benefit" value="{{event.benefit}}"></label><label>Story <textarea class="tbe-grow" rows="2" name="system.events.{{name}}.story">{{event.story}}</textarea></label></div>{{/each}}</div>
  <h3>Shared histories <button type="button" data-add="sharedHistories">Add</button></h3><div class="tbe-list tbe-histories"><div class="tbe-list-heading"><span>Character</span><span>Event</span><span>Skill benefit</span><span>Story</span><span></span></div>{{#each system.sharedHistories as |row i|}}<div class="tbe-list-row"><input placeholder="Character" aria-label="Character" name="system.sharedHistories.{{i}}.character" value="{{row.character}}"><input placeholder="Event" aria-label="Event" name="system.sharedHistories.{{i}}.event" value="{{row.event}}"><input placeholder="Skill benefit" aria-label="Skill benefit" name="system.sharedHistories.{{i}}.skill" value="{{row.skill}}"><textarea class="tbe-grow" rows="1" placeholder="Story" aria-label="Story" name="system.sharedHistories.{{i}}.story">{{row.story}}</textarea><button type="button" data-remove="sharedHistories:{{i}}">×</button></div>{{/each}}</div>
  <h3>Relationship NPCs <button type="button" data-add="relationships">Add</button></h3><div class="tbe-list tbe-relationships"><div class="tbe-list-heading"><span>Name</span><span>Relationship</span><span>Notes</span><span></span></div>{{#each system.relationships as |row i|}}<div class="tbe-list-row"><input placeholder="Name" aria-label="Name" name="system.relationships.{{i}}.name" value="{{row.name}}"><input placeholder="Friend, Patron, Rival, Adversary" aria-label="Relationship" name="system.relationships.{{i}}.type" value="{{row.type}}"><textarea class="tbe-grow" rows="1" placeholder="Notes" aria-label="Notes" name="system.relationships.{{i}}.notes">{{row.notes}}</textarea><button type="button" data-remove="relationships:{{i}}">×</button></div>{{/each}}</div>
  <h3>Personality traits <button type="button" data-add="personalityTraits">Add</button></h3><div class="tbe-list tbe-traits"><div class="tbe-list-heading"><span>Trait</span><span>Description</span><span></span></div>{{#each system.personalityTraits as |row i|}}<div class="tbe-list-row"><input placeholder="Trait" aria-label="Trait" name="system.personalityTraits.{{i}}.name" value="{{row.name}}"><textarea class="tbe-grow" rows="1" placeholder="Description" aria-label="Description" name="system.personalityTraits.{{i}}.description">{{row.description}}</textarea><button type="button" data-remove="personalityTraits:{{i}}">×</button></div>{{/each}}</div>
  <h3>Goals <button type="button" data-add="goals">Add goal</button></h3><div class="tbe-list tbe-goals"><div class="tbe-list-heading"><span>Goal</span><span>Shared</span><span></span></div>{{#each system.goals as |row i|}}<div class="tbe-list-row"><textarea class="tbe-grow" rows="1" placeholder="Goal" aria-label="Goal" name="system.goals.{{i}}.text">{{row.text}}</textarea><label class="tbe-check"><input aria-label="Shared" type="checkbox" name="system.goals.{{i}}.shared" {{#if row.shared}}checked{{/if}}></label><button type="button" data-remove="goals:{{i}}">×</button></div>{{/each}}</div></section>
  <section id="tbe-gear"><h2>Equipment</h2>
    <div class="tbe-grid"><label>Silver pieces <input type="number" name="system.silver" value="{{system.silver}}"></label><label>Maximum Inventory ENC <input type="number" name="system.encumbranceMax" value="{{inventoryMax}}"></label></div>
    <div class="tbe-enc-totals">
      <div {{#if weaponOver}}class="tbe-over"{{/if}}><b>Weapon ENC</b><span>{{weaponENC}} / 6</span></div>
      <div {{#if inventoryOver}}class="tbe-over"{{/if}}><b>Inventory ENC</b><span>{{inventoryENC}} / {{inventoryMax}}</span></div>
      <div><b>Worn Bulk</b><span>{{wornBulk}}</span></div><div><b>Armour Initiative penalty</b><span>−{{armorInitiativePenalty}}</span></div><div><b>Total carried burden</b><span>{{carriedBurden}}</span></div>
    </div><p>Inventory ENC includes coins (1 per 500 sp) and carried armour (1 per piece). The four standard Supply Dice use no Inventory ENC. Total carried burden adds Weapon ENC, Inventory ENC and worn Bulk for reference; their limits still apply separately. At Home contributes zero.</p>
    <div class="tbe-add-items"><button type="button" data-add="item">+ Item</button><button type="button" data-add="weapon">Add weapon</button><button type="button" data-add="armor">Add armour</button><button type="button" data-add="shield">Add shield</button><button type="button" data-add="gear">Add gear</button></div>
    <h3>Worn armour</h3><p>Assign each worn Armour Item a body location to place it here. Sundered armour provides 0 AP. A shield only protects when Held and Ready.</p>
    <div class="tbe-armor-slots">{{#each armorSlots as |slot|}}<div class="tbe-armor-slot {{#if slot.conflict}}tbe-over{{/if}}"><b>{{slot.location}}</b><span>AP {{slot.protection}}</span>
      {{#each slot.items as |item|}}<div class="tbe-slot-item" draggable="true" data-item-id="{{item.id}}"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">{{item.name}}</button>{{#if item.system.sundered}}<span>Sundered</span>{{/if}}<select aria-label="Where is {{item.name}}?" data-item-placement="{{item.id}}">{{#each @root.placementOptions.armor as |choice|}}<option value="{{choice.value}}" {{#if (eq choice.value (lookup @root.itemPlacements item.id))}}selected{{/if}}>{{choice.label}}</option>{{/each}}</select>{{#if @root.isGM}}<button type="button" title="Copy to Items Directory" data-copy-item="{{item.id}}">Copy to Items</button>{{/if}}<button type="button" aria-label="Remove {{item.name}}" data-delete-item="{{item.id}}">×</button></div>{{/each}}
      {{#if slot.conflict}}<strong>More than one armour piece assigned here. Choose one to wear.</strong>{{/if}}
    </div>{{/each}}</div>
    {{#if unassignedArmor.length}}<p class="tbe-over">Worn armour missing a valid body location: {{#each unassignedArmor as |item|}}{{item.name}} {{/each}}</p>{{/if}}
    {{#each equipmentAreas as |area|}}<h3>{{area.title}}</h3><div class="tbe-equipment-cards">{{#each area.items as |item|}}
      <div class="tbe-equipment-card" draggable="true" data-item-id="{{item.id}}"><div class="tbe-equipment-title"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">{{item.name}}</button><span>{{#if (eq item.type "armor")}}Armour{{else}}{{item.type}}{{/if}}</span><select aria-label="Where is {{item.name}}?" data-item-placement="{{item.id}}">{{#each (lookup @root.placementOptions item.type) as |choice|}}<option value="{{choice.value}}" {{#if (eq choice.value (lookup @root.itemPlacements item.id))}}selected{{/if}}>{{choice.label}}</option>{{/each}}</select>{{#if @root.isGM}}<button type="button" title="Copy to Items Directory" data-copy-item="{{item.id}}">Copy to Items</button>{{/if}}<button type="button" aria-label="Remove {{item.name}}" data-delete-item="{{item.id}}">×</button></div>
        {{#if (eq item.type "weapon")}}<div class="tbe-weapon-facts"><div><b>SP</b><span>{{item.system.price}}</span></div><div><b>RCH</b><span>{{item.system.reach}}</span></div><div><b>DMG</b><span>{{item.system.damage}}</span></div><div><b>CL</b><span>{{item.system.chooseLocation}}</span></div><div><b>CS</b><span>{{item.system.circumventShield}}</span></div><div><b>DIS</b><span>{{item.system.disarm}}</span></div><div><b>T</b><span>{{item.system.trip}}</span></div><div><b>ENC</b><span>{{item.system.encumbrance}}</span></div><div><b>RNG</b><span>{{item.system.range}}</span></div></div>{{/if}}
        {{#if (eq item.type "shield")}}<div class="tbe-weapon-facts"><div><b>Size</b><span>{{item.system.size}}</span></div><div><b>AP</b><span>{{#if item.system.split}}0 (split){{else}}{{item.system.protection}}{{/if}}</span></div><div><b>ShB</b><span>{{item.system.shieldBash}}</span></div><div><b>ENC</b><span>{{item.system.encumbrance}}</span></div></div>{{/if}}
        {{#if (eq item.type "armor")}}<div class="tbe-weapon-facts"><div><b>AP</b><span>{{#if item.system.sundered}}0 (sundered){{else}}{{item.system.protection}}{{/if}}</span></div><div><b>Bulk when worn</b><span>{{item.system.bulk}}</span></div><div><b>Inventory ENC</b><span>1</span></div></div>{{/if}}
        {{#if (eq item.type "gear")}}<div class="tbe-weapon-facts"><div><b>Quantity</b><span>{{item.system.quantity}}</span></div><div><b>ENC each</b><span>{{item.system.encumbrance}}</span></div><div><b>SP each</b><span>{{item.system.price}}</span></div></div>{{/if}}
        {{#if item.system.notes}}<div class="tbe-weapon-notes"><b>Notes</b><span>{{item.system.notes}}</span></div>{{/if}}
      </div>{{/each}}</div>{{/each}}
  <h3>Supply Dice</h3><div class="tbe-grid"><label>Gear <select name="system.supply.gear"><option value="d12" {{#if (eq supplyDisplay.gear "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.gear "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.gear "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.gear "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.gear "depleted")}}selected{{/if}}>Depleted</option></select></label><label>Ammo <select name="system.supply.ammo"><option value="d12" {{#if (eq supplyDisplay.ammo "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.ammo "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.ammo "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.ammo "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.ammo "depleted")}}selected{{/if}}>Depleted</option></select></label><label>Rations <select name="system.supply.rations"><option value="d12" {{#if (eq supplyDisplay.rations "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.rations "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.rations "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.rations "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.rations "depleted")}}selected{{/if}}>Depleted</option></select></label><label>Medical <select name="system.supply.medical"><option value="d12" {{#if (eq supplyDisplay.medical "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.medical "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.medical "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.medical "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.medical "depleted")}}selected{{/if}}>Depleted</option></select></label></div>
  <h3>Notes</h3><textarea class="tbe-grow" rows="3" name="system.notes">{{system.notes}}</textarea></section>
</div>
