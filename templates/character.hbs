<div class="tbe-sheet-body">
  <header class="tbe-header"><button type="button" class="tbe-portrait" data-portrait title="Choose character picture" aria-label="Choose character picture"><img src="{{document.img}}" alt="{{document.name}}" width="72" height="72"></button><label class="tbe-header-name">Character name <input name="name" value="{{document.name}}"></label><label class="tbe-header-concept">Concept <textarea class="tbe-grow" rows="2" name="system.description">{{system.description}}</textarea></label></header>
  <nav class="tbe-nav" aria-label="Character sections; drag tabs to reorder sections">{{#each sectionTabs as |tab|}}<button type="button" data-section="{{tab.id}}" draggable="{{@root.canReorderTabs}}" title="{{tab.label}} — drag to reorder">{{tab.label}}</button>{{/each}}</nav>
  <div class="tbe-sheet-export"><button type="button" data-character-creator title="Create a character in guided stages; closing the window resets the draft">Character creator</button><button type="button" data-save-pdf>Save as PDF</button><button type="button" data-backup-character title="Download a Foundry JSON backup that can be imported later">Back up data</button></div>
  <section id="tbe-identity"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="identity" aria-label="Toggle Identity" aria-expanded="true">▾</button>Identity</h2><div class="tbe-grid tbe-identity-fields">
    <label>Race <input name="system.race" value="{{system.race}}"></label><label>Culture <input name="system.culture" value="{{system.culture}}"></label><label>Sex <input name="system.sex" value="{{system.sex}}"></label><label>Age <input name="system.age" value="{{system.age}}"></label>
    <label>Previous career <input name="system.career" value="{{system.career}}"></label><label>Size <input name="system.size" value="{{system.size}}"></label><label>Status <input type="number" name="system.status" value="{{system.status}}"></label><div class="tbe-xp-summary"><label>Total XP <input type="number" step="1" data-xp-total value="{{xp.total}}" title="Existing XP plus recorded rewards; edit to adjust the starting total"></label><label>Spent XP <output>{{xp.spent}}</output></label><label>Current XP <output>{{xp.current}}</output></label><button type="button" data-xp-ledger>XP log</button></div>
  </div>
  <h3>Ability scores & descriptors <button type="button" data-add="abilityScores">Add</button></h3><div class="tbe-list tbe-abilities"><div class="tbe-list-heading"><span>Ability score</span><span>Descriptor</span><span></span></div>{{#each system.abilityScores as |row i|}}<div class="tbe-list-row"><input aria-label="Ability score" placeholder="STR, DEX, CON, INT, WIS or CHA" name="system.abilityScores.{{i}}.name" value="{{row.name}}"><input aria-label="Descriptor" placeholder="Descriptor" name="system.abilityScores.{{i}}.descriptor" value="{{row.descriptor}}"><button type="button" aria-label="Delete ability score" title="Delete ability score" data-remove="abilityScores:{{i}}">×</button></div>{{/each}}</div>
  <h3 data-drop-race>Race traits <button type="button" data-add="racialTraits">Add</button></h3><div class="tbe-list tbe-traits"><div class="tbe-list-heading"><span>Trait</span><span>Effect</span><span></span></div>{{#each system.racialTraits as |row i|}}<div class="tbe-list-row"><input aria-label="Trait" placeholder="Trait" name="system.racialTraits.{{i}}.name" value="{{row.name}}"><textarea class="tbe-grow" rows="1" aria-label="Effect" placeholder="Effect" name="system.racialTraits.{{i}}.effect">{{row.effect}}</textarea><input type="hidden" name="system.racialTraits.{{i}}.source" value="{{row.source}}"><button type="button" aria-label="Delete race trait" title="Delete race trait" data-remove="racialTraits:{{i}}">×</button></div>{{/each}}</div>
  </section>
  <section id="tbe-skills"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="skills" aria-label="Toggle Skills" aria-expanded="true">▾</button>Skills <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Edit values directly after making your character creation choices. Ex is Expertise; S marks Savvy." data-tbe-tip="Edit values directly after making your character creation choices. Ex is Expertise; S marks Savvy.">i</span></h2>
  {{#each skillGroups as |group|}}{{#unless (eq group.category "Strands")}}{{#unless (eq group.category "Binds")}}{{#unless (eq group.category "Magic")}}<h3>{{group.category}} <button type="button" data-add="customSkills" data-category="{{group.category}}">+ Skill</button></h3><div class="tbe-skill-head"><span>Skill</span><span>Starting</span><span>Increases</span><span>Total %</span><span tabindex="0" data-tbe-tip="Expertise sets a minimum number of success levels on a successful roll.">Ex</span><span tabindex="0" data-tbe-tip="Savvy is a special skill benefit gained from character creation or Talents.">S</span></div><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span tabindex="0" data-tbe-tip="{{row.description}}">{{row.name}}</span><input aria-label="{{row.name}} starting percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><span class="tbe-skill-number">{{row.increases}}</span><button type="button" class="tbe-skill-roll tbe-skill-number" data-roll-skill="{{row.path}}" data-skill-name="{{row.name}}" title="Roll {{row.name}}" aria-label="Roll {{row.name}}">{{row.total}}{{#if row.overflowPenalty}}<small class="tbe-overflow-badge" title="Inventory overflow penalty; edit when rolling">{{row.overflowPenalty}}</small>{{/if}}</button><input aria-label="{{row.name}} Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"><label class="tbe-check">S <input type="checkbox" name="{{row.path}}.savvy" {{#if row.data.savvy}}checked{{/if}}></label><details class="tbe-skill-breakdown" data-skill-breakdown="{{row.path}}"><summary title="Show or hide skill increases" aria-label="Show or hide skill increases" data-tbe-tip="Show or hide skill increases">▸</summary><div class="tbe-breakdown-grid"><label>Ability<output class="tbe-breakdown-ability">{{row.ability}}</output></label><label>Race<input type="number" name="{{row.path}}.race" value="{{row.data.race}}"></label><label>Culture<input type="number" name="{{row.path}}.culture" value="{{row.data.culture}}"></label><label>Life Events<input type="number" name="{{row.path}}.lifeEvents" value="{{row.data.lifeEvents}}"></label><label>Career<input type="number" name="{{row.path}}.career" value="{{row.data.career}}"></label><label>Rounding Out<input type="number" name="{{row.path}}.rounding" value="{{row.data.rounding}}"></label><label>XP<input type="number" name="{{row.path}}.xp" value="{{row.data.xp}}"></label><label>Other<input type="number" name="{{row.path}}.other" value="{{row.data.other}}"></label></div></details></div>{{/each}}{{#each (lookup @root.customSkillGroups group.category) as |row|}}<div class="tbe-skill tbe-custom-skill"><input aria-label="Custom skill name" placeholder="Skill name" title="{{row.description}}" name="system.customSkills.{{row.index}}.name" value="{{row.name}}"><input type="number" aria-label="Starting percent" name="system.customSkills.{{row.index}}.value" value="{{row.value}}"><span class="tbe-skill-number">{{row.increases}}</span><button type="button" class="tbe-skill-roll tbe-skill-number" data-roll-skill="system.customSkills.{{row.index}}" data-skill-name="{{row.name}}" title="Roll {{row.name}}" aria-label="Roll {{row.name}}">{{row.total}}{{#if row.overflowPenalty}}<small class="tbe-overflow-badge" title="Inventory overflow penalty; edit when rolling">{{row.overflowPenalty}}</small>{{/if}}</button><input type="number" aria-label="Expertise" name="system.customSkills.{{row.index}}.expertise" value="{{row.expertise}}"><label class="tbe-check">S <input type="checkbox" name="system.customSkills.{{row.index}}.savvy" {{#if row.savvy}}checked{{/if}}></label><details class="tbe-skill-breakdown" data-skill-breakdown="custom:{{row.index}}"><summary title="Show or hide skill increases" aria-label="Show or hide skill increases" data-tbe-tip="Show or hide skill increases">▸</summary><div class="tbe-breakdown-grid"><label>Ability<output class="tbe-breakdown-ability">{{row.ability}}</output></label><label>Race<input type="number" name="system.customSkills.{{row.index}}.race" value="{{row.race}}"></label><label>Culture<input type="number" name="system.customSkills.{{row.index}}.culture" value="{{row.culture}}"></label><label>Life Events<input type="number" name="system.customSkills.{{row.index}}.lifeEvents" value="{{row.lifeEvents}}"></label><label>Career<input type="number" name="system.customSkills.{{row.index}}.career" value="{{row.career}}"></label><label>Rounding Out<input type="number" name="system.customSkills.{{row.index}}.rounding" value="{{row.rounding}}"></label><label>XP<input type="number" name="system.customSkills.{{row.index}}.xp" value="{{row.xp}}"></label><label>Other<input type="number" name="system.customSkills.{{row.index}}.other" value="{{row.other}}"></label><input type="hidden" name="system.customSkills.{{row.index}}.category" value="{{row.category}}"><label class="tbe-breakdown-description">Description<input class="tbe-custom-description" aria-label="Skill description" placeholder="Description" name="system.customSkills.{{row.index}}.description" value="{{row.description}}"></label></div></details><button type="button" aria-label="Delete custom skill" title="Delete custom skill" data-remove="customSkills:{{row.index}}">×</button></div>{{/each}}</div>{{/unless}}{{/unless}}{{/unless}}{{/each}}
  <h3>Languages, custom -wise and other skills <button type="button" data-add="customSkills">Add custom skill</button></h3><div class="tbe-skill-head"><span>Skill</span><span>Starting</span><span>Increases</span><span>Total %</span><span tabindex="0" data-tbe-tip="Expertise sets a minimum number of success levels on a successful roll.">Ex</span><span tabindex="0" data-tbe-tip="Savvy is a special skill benefit gained from character creation or Talents.">S</span></div><div class="tbe-skill-list">{{#each otherCustomSkills as |row|}}<div class="tbe-skill tbe-custom-skill"><input aria-label="Custom skill name" placeholder="Skill name" title="{{row.description}}" name="system.customSkills.{{row.index}}.name" value="{{row.name}}"><input type="number" aria-label="Starting percent" name="system.customSkills.{{row.index}}.value" value="{{row.value}}"><span class="tbe-skill-number">{{row.increases}}</span><button type="button" class="tbe-skill-roll tbe-skill-number" data-roll-skill="system.customSkills.{{row.index}}" data-skill-name="{{row.name}}" title="Roll {{row.name}}" aria-label="Roll {{row.name}}">{{row.total}}{{#if row.overflowPenalty}}<small class="tbe-overflow-badge" title="Inventory overflow penalty; edit when rolling">{{row.overflowPenalty}}</small>{{/if}}</button><input type="number" aria-label="Expertise" name="system.customSkills.{{row.index}}.expertise" value="{{row.expertise}}"><label class="tbe-check">S <input type="checkbox" name="system.customSkills.{{row.index}}.savvy" {{#if row.savvy}}checked{{/if}}></label><details class="tbe-skill-breakdown" data-skill-breakdown="custom:{{row.index}}"><summary title="Show or hide skill increases" aria-label="Show or hide skill increases" data-tbe-tip="Show or hide skill increases">▸</summary><div class="tbe-breakdown-grid"><label>Ability<output class="tbe-breakdown-ability">{{row.ability}}</output></label><label>Race<input type="number" name="system.customSkills.{{row.index}}.race" value="{{row.race}}"></label><label>Culture<input type="number" name="system.customSkills.{{row.index}}.culture" value="{{row.culture}}"></label><label>Life Events<input type="number" name="system.customSkills.{{row.index}}.lifeEvents" value="{{row.lifeEvents}}"></label><label>Career<input type="number" name="system.customSkills.{{row.index}}.career" value="{{row.career}}"></label><label>Rounding Out<input type="number" name="system.customSkills.{{row.index}}.rounding" value="{{row.rounding}}"></label><label>XP<input type="number" name="system.customSkills.{{row.index}}.xp" value="{{row.xp}}"></label><label>Other<input type="number" name="system.customSkills.{{row.index}}.other" value="{{row.other}}"></label><label class="tbe-breakdown-category">Category<input class="tbe-custom-category" aria-label="Category" name="system.customSkills.{{row.index}}.category" value="{{row.category}}" placeholder="Category"></label><label class="tbe-breakdown-description">Description<input class="tbe-custom-description" aria-label="Skill description" placeholder="Description" name="system.customSkills.{{row.index}}.description" value="{{row.description}}"></label></div></details><button type="button" aria-label="Delete custom skill" title="Delete custom skill" data-remove="customSkills:{{row.index}}">×</button></div>{{/each}}</div></section>
  <section id="tbe-magic"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="magic" aria-label="Toggle Magic" aria-expanded="true">▾</button>Magic</h2><div class="tbe-magic-actions"><button type="button" data-cast-spell>Cast a spell</button><button type="button" data-request-miracle>Request a miracle</button></div><h3>PIETY <span tabindex="0" data-tbe-tip="Godbound begin with 30 Piety. Piety can rise through pious acts (maximum 90) and falls when miracles cost Piety. It cannot be increased with XP or gain Expertise.">ⓘ</span></h3><div class="tbe-piety-status"><label>Current Piety <input type="number" min="0" max="90" data-piety-current value="{{currentPiety}}" title="Set current Piety; the log remains intact"></label><button type="button" data-piety-ledger>Piety log</button><label>Holy symbol die <select name="system.holySymbolDie"><option value="d12" {{#if (eq system.holySymbolDie "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq system.holySymbolDie "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq system.holySymbolDie "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq system.holySymbolDie "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq system.holySymbolDie "depleted")}}selected{{/if}}>depleted</option></select></label></div>
  {{#each skillGroups as |group|}}{{#if (eq group.category "Binds")}}<h3>Binds</h3><div class="tbe-skill-head"><span>Skill</span><span>Starting</span><span>Increases</span><span>Total %</span><span tabindex="0" data-tbe-tip="Expertise sets a minimum number of success levels on a successful roll.">Ex</span><span tabindex="0" data-tbe-tip="Savvy is a special skill benefit gained from character creation or Talents.">S</span></div><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span tabindex="0" data-tbe-tip="{{row.description}}">{{row.name}}</span><input aria-label="{{row.name}} starting percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><span class="tbe-skill-number">{{row.increases}}</span><button type="button" class="tbe-skill-roll tbe-skill-number" data-roll-skill="{{row.path}}" data-skill-name="{{row.name}}" title="Roll {{row.name}}" aria-label="Roll {{row.name}}">{{row.total}}{{#if row.overflowPenalty}}<small class="tbe-overflow-badge" title="Inventory overflow penalty; edit when rolling">{{row.overflowPenalty}}</small>{{/if}}</button><input aria-label="{{row.name}} Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"><label class="tbe-check">S <input type="checkbox" name="{{row.path}}.savvy" {{#if row.data.savvy}}checked{{/if}}></label><details class="tbe-skill-breakdown" data-skill-breakdown="{{row.path}}"><summary title="Show or hide skill increases" aria-label="Show or hide skill increases" data-tbe-tip="Show or hide skill increases">▸</summary><div class="tbe-breakdown-grid"><label>Ability<output class="tbe-breakdown-ability">{{row.ability}}</output></label><label>Race<input type="number" name="{{row.path}}.race" value="{{row.data.race}}"></label><label>Culture<input type="number" name="{{row.path}}.culture" value="{{row.data.culture}}"></label><label>Life Events<input type="number" name="{{row.path}}.lifeEvents" value="{{row.data.lifeEvents}}"></label><label>Career<input type="number" name="{{row.path}}.career" value="{{row.data.career}}"></label><label>Rounding Out<input type="number" name="{{row.path}}.rounding" value="{{row.data.rounding}}"></label><label>XP<input type="number" name="{{row.path}}.xp" value="{{row.data.xp}}"></label><label>Other<input type="number" name="{{row.path}}.other" value="{{row.data.other}}"></label></div></details></div>{{/each}}</div>{{/if}}{{/each}}
    <h3>Strands</h3><div class="tbe-strand-columns">{{#each strandColumns as |column|}}<div class="tbe-strand-column"><div class="tbe-skill-head tbe-strand-head"><span>Strand</span><span>Level</span><span>Thin</span></div><div class="tbe-skill-list">{{#each column as |row|}}<div class="tbe-skill tbe-skill-strand"><span tabindex="0" data-tbe-tip="{{row.description}}">{{row.name}}</span><input aria-label="{{row.name}} level" type="number" name="{{row.path}}.level" value="{{row.data.level}}"><label class="tbe-check"><input aria-label="Thin Strand" type="checkbox" name="{{row.path}}.thin" {{#if row.data.thin}}checked{{/if}}></label></div>{{/each}}</div></div>{{/each}}</div>
    <div class="tbe-grid tbe-magic-identity"><label>True Name <input name="system.trueName" value="{{system.trueName}}"></label><label>Fraying <input type="number" name="system.fraying" value="{{system.fraying}}"></label></div>
    <h3>Threads <button type="button" data-add="thread">Add thread</button></h3><div class="tbe-talent-cards">{{#each threads as |item|}}<div class="tbe-talent-card tbe-equipment-card" draggable="true" data-item-id="{{item.id}}"><details class="tbe-equipment-details" data-equipment-details="{{item.id}}"><summary class="tbe-equipment-summary">{{item.name}}</summary>
      <div class="tbe-talent-title"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">Edit {{item.name}}</button><button type="button" aria-label="Remove {{item.name}}" data-delete-item="{{item.id}}">×</button></div>
      {{#if item.system.description}}<div class="tbe-talent-detail"><b>Description</b><span>{{item.system.description}}</span></div>{{/if}}
      {{#if (eq item.system.useMode "points")}}<label class="tbe-thread-points">Points remaining <input type="number" min="0" step="1" aria-label="{{item.name}} points remaining" data-thread-points="{{item.id}}" value="{{item.system.points}}"></label>{{/if}}
      {{#if item.system.bindsAndStrands}}<div class="tbe-talent-detail"><b>Binds &amp; Strands</b><span>{{item.system.bindsAndStrands}}</span></div>{{/if}}
    </details>{{#unless (eq item.system.useMode "points")}}<button type="button" class="tbe-equipment-attack" data-roll-thread="{{item.id}}" title="Roll {{item.name}} Thread die ({{item.system.die}})">Roll Thread</button>{{/unless}}</div>{{/each}}</div></section>
  <section id="tbe-combat"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="combat" aria-label="Toggle Combat" aria-expanded="true">▾</button>Combat <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Empty boxes are unused Resolve. Slashes mark spent Resolve from the left; X marks Fatigue from the right. Permanent Fatigue has a different colour. A full track cannot take more Fatigue without a Fatigue-based wound." data-tbe-tip="Empty boxes are unused Resolve. Slashes mark spent Resolve from the left; X marks Fatigue from the right. Permanent Fatigue has a different colour. A full track cannot take more Fatigue without a Fatigue-based wound.">i</span></h2><div class="tbe-grid tbe-combat-values">
  <label>Current Resolve <input type="number" name="system.resolve.value" value="{{system.resolve.value}}"></label><label>Maximum Resolve <input type="number" data-resolve-max value="{{system.resolve.max}}"></label><label>Fatigue <input type="number" min="0" step="1" data-resolve-fatigue value="{{system.resolve.fatigue}}" aria-label="Temporary Fatigue"></label><label>Permanent fatigue <input type="number" data-permanent-fatigue value="{{system.resolve.permanentFatigue}}"></label>
  </div><p class="tbe-resolve-help">Click an empty box to spend Resolve (/). Click a slash to recover it. Right-click to add Fatigue (×); click an X to remove it. Permanent Fatigue is changed with its number box.</p><button type="button" data-add-fatigue>+ Fatigue</button><div class="tbe-resolve-track" role="group" aria-label="Resolve and Fatigue track">{{#each resolveTrack as |box|}}<button type="button" class="tbe-resolve-box tbe-resolve-{{box.state}}" data-resolve-box="{{box.index}}" aria-label="Resolve space {{box.index}}: {{box.state}}" title="{{box.state}}">{{#if box.permanent}}×{{else}}{{#if box.fatigue}}×{{else}}{{#if box.spent}}╱{{/if}}{{/if}}{{/if}}</button>{{/each}}</div><div class="tbe-grid tbe-combat-values">
  <label>Initiative <input type="number" name="system.attributes.initiative" value="{{system.attributes.initiative}}"></label><label><span data-tbe-tip="Persistent Initiative penalty in addition to worn armour. Enter a positive amount to subtract; temporary modifiers go in the roll dialogue.">Other Initiative penalty</span> <input type="number" min="0" name="system.attributes.initiativePenalty" value="{{system.attributes.initiativePenalty}}"></label><button type="button" data-roll-initiative>Roll Initiative</button><label>Toughness <input type="number" name="system.attributes.toughness" value="{{system.attributes.toughness}}"></label><label><span data-tbe-tip="Total lethal Wound Points at which the character dies.">Death Threshold</span> <input type="number" name="system.attributes.deathThreshold" value="{{system.attributes.deathThreshold}}"></label><label><span data-tbe-tip="Total lethal Wound Points at which wounds become more dangerous.">Lethality Level</span> <input type="number" name="system.attributes.lethalityLevel" value="{{system.attributes.lethalityLevel}}"></label></div>
  <div class="tbe-rise-action"><h3>Rise from Prone <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Use Athletics, or the skill chosen for Rise a Fighter. Account for body armour and additional Engaged foes when rolling." data-tbe-tip="Use Athletics, or the skill chosen for Rise a Fighter. Account for body armour and additional Engaged foes when rolling.">i</span></h3><button type="button" data-rise-from-prone>Roll Rise from Prone</button></div>
  <h3><span class="tbe-heading-label">Wounds <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Lethality Level (LL) and Death Threshold apply to the character’s total lethal WP, not to a separate limit on each limb. Location WP (L + NL) is used for impairment. Record lethal and nonlethal Wound Points by body location." data-tbe-tip="Lethality Level (LL) and Death Threshold apply to the character’s total lethal WP, not to a separate limit on each limb. Location WP (L + NL) is used for impairment. Record lethal and nonlethal Wound Points by body location.">i</span></span><button type="button" data-add="wounds">Add wound</button></h3>

  <div class="tbe-wound-actions"><button type="button" data-infection-roll="journey">Journey Infection</button><button type="button" data-infection-roll="sepsis">Sepsis check</button></div>
  <h3>Conditions <span class="tbe-info" tabindex="0" data-tbe-tip="Tick conditions to record their current effects. Wound Die results can tick relevant conditions; clear them when the condition ends or is avoided with Resolve.">i</span></h3>
  <div class="tbe-condition-grid">{{#each conditionOptions as |condition|}}<label class="tbe-condition" tabindex="0" data-tbe-tip="{{condition.help}}"><input type="checkbox" name="system.conditions.{{condition.key}}" {{#if condition.active}}checked{{/if}}> {{condition.label}}</label>{{/each}}</div>
  <div class="tbe-wound-overall"><div><b>Total lethal WP</b><span>{{totalLethalWP}} / LL {{ll}}</span></div><div><b>Total nonlethal WP</b><span>{{totalNonlethalWP}}</span></div><div><b>Death Threshold</b><span>{{system.attributes.deathThreshold}}</span></div></div>
  <div class="tbe-wound-summary"><div class="tbe-wound-summary-row tbe-wound-summary-heading"><span>Location</span><span>L WP</span><span>NL WP</span><span>Total WP for impairment</span></div>{{#each woundSummary as |slot|}}<div class="tbe-wound-summary-row"><b>{{slot.location}}</b><span>{{slot.lethal}}</span><span>{{slot.nonlethal}}</span><span>{{slot.total}}</span></div>{{/each}}</div>
  {{#if unassignedWounds.length}}<p class="tbe-over">Some wounds have WP but no recognised general location. Choose a location on each wound below to include it in the location summary.</p>{{/if}}
  <div class="tbe-wound-cards">{{#each system.wounds as |row i|}}<div class="tbe-wound-card">
    <div class="tbe-wound-fields"><label>General location <select name="system.wounds.{{i}}.generalLocation"><option value="">Choose location</option><option value="Head" {{#if (eq row.generalLocation "Head")}}selected{{/if}}>Head</option><option value="Body" {{#if (eq row.generalLocation "Body")}}selected{{/if}}>Body</option><option value="Right Arm" {{#if (eq row.generalLocation "Right Arm")}}selected{{/if}}>Right Arm</option><option value="Left Arm" {{#if (eq row.generalLocation "Left Arm")}}selected{{/if}}>Left Arm</option><option value="Right Leg" {{#if (eq row.generalLocation "Right Leg")}}selected{{/if}}>Right Leg</option><option value="Left Leg" {{#if (eq row.generalLocation "Left Leg")}}selected{{/if}}>Left Leg</option></select></label>
    <label>Detailed location <input placeholder="e.g. right forearm" name="system.wounds.{{i}}.location" value="{{row.location}}"></label>
    <label>Injury <textarea class="tbe-grow" rows="1" name="system.wounds.{{i}}.detail">{{row.detail}}</textarea></label>
    <label>WP <input type="number" min="0" name="system.wounds.{{i}}.points" value="{{row.points}}"></label></div>
    <div class="tbe-wound-flags"><label class="tbe-check">Lethal (uncheck for NL) <input type="checkbox" name="system.wounds.{{i}}.lethal" {{#if row.lethal}}checked{{/if}}></label><label class="tbe-check">Ritual <input type="checkbox" name="system.wounds.{{i}}.ritual" {{#if row.ritual}}checked{{/if}}></label><label class="tbe-check">Infected <input type="checkbox" name="system.wounds.{{i}}.infection" {{#if row.infection}}checked{{/if}}></label><label class="tbe-check">Septic <input type="checkbox" name="system.wounds.{{i}}.septic" {{#if row.septic}}checked{{/if}}></label><button type="button" data-wound-roll="{{i}}" title="Roll d10 + Toughness against the location’s total WP">Wound Die</button><button type="button" data-infection-roll="attack" data-wound-index="{{i}}" title="Check this wound after an infectious attack">Infection Die</button><button type="button" data-infection-roll="event" data-wound-index="{{i}}" title="Infection Event targets the highest uninfected lethal wound">Event</button><button type="button" aria-label="Delete wound" title="Delete wound" data-remove="wounds:{{i}}">×</button></div>
  </div>{{/each}}</div>
  <label>Sepsis deadline (in game; 48 hours from onset) <input name="system.sepsisDeadline" value="{{system.sepsisDeadline}}" placeholder="e.g. Tomorrow at sundown"></label>
  <h3>Custom resources <button type="button" data-add="resources">Add resource</button></h3><div class="tbe-list tbe-resources"><div class="tbe-list-heading"><span>Resource</span><span>Current</span><span></span><span>Maximum</span><span></span></div>{{#each system.resources as |row i|}}<div class="tbe-list-row"><input placeholder="Resource name" aria-label="Resource name" name="system.resources.{{i}}.name" value="{{row.name}}"><input aria-label="Current" type="number" name="system.resources.{{i}}.value" value="{{row.value}}"><span>/</span><input aria-label="Maximum" type="number" name="system.resources.{{i}}.max" value="{{row.max}}"><button type="button" aria-label="Delete resource" title="Delete resource" data-remove="resources:{{i}}">×</button></div>{{/each}}</div>
  <h3><span class="tbe-heading-label">Talents <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Open a talent to read its effect or edit its Item; drag one here from the Items sidebar. Drag an owned Item into the Items sidebar to keep a reusable copy." data-tbe-tip="Open a talent to read its effect or edit its Item; drag one here from the Items sidebar. Drag an owned Item into the Items sidebar to keep a reusable copy.">i</span></span><button type="button" data-add="talent">Add talent</button></h3><div class="tbe-talent-cards">{{#each talents as |item|}}<details class="tbe-talent-card tbe-collapsible-talent" draggable="true" data-item-id="{{item.id}}" data-talent-details="{{item.id}}">
    <summary class="tbe-talent-title">{{item.name}}</summary><button type="button" class="tbe-talent-delete" aria-label="Remove {{item.name}}" data-delete-item="{{item.id}}">×</button>
    <button type="button" class="tbe-item-link tbe-talent-edit" data-open-item="{{item.id}}">Edit {{item.name}}</button>
    {{#if item.system.source}}<div class="tbe-talent-detail"><b>Source</b><span>{{item.system.source}}</span></div>{{/if}}
    {{#if item.system.reference}}<div class="tbe-talent-detail"><b>Reference</b><span>{{item.system.reference}}</span></div>{{/if}}
    {{#if item.system.effect}}<div class="tbe-talent-detail"><b>Effect</b><span>{{item.system.effect}}</span></div>{{/if}}
    {{#if item.system.requirements}}<div class="tbe-talent-detail"><b>Requirements</b><span>{{item.system.requirements}}</span></div>{{/if}}
  </details>{{/each}}</div>
  </section>
  <section id="tbe-gear"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="gear" aria-label="Toggle Gear" aria-expanded="true">▾</button>Gear <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Only At Hand weapons and shields count towards the At Hand ENC limit. Held and Ready has no ENC limit. Inventory ENC includes coins (1 per 500 sp) and carried armour (1 per piece). The four standard Supply Dice use no Inventory ENC. Worn Bulk determines the Armour Initiative penalty. Dropped and At Home items contribute zero." data-tbe-tip="Only At Hand weapons and shields count towards the At Hand ENC limit. Held and Ready has no ENC limit. Inventory ENC includes coins (1 per 500 sp) and carried armour (1 per piece). The four standard Supply Dice use no Inventory ENC. Worn Bulk determines the Armour Initiative penalty. Dropped and At Home items contribute zero.">i</span></h2>
    <div class="tbe-enc-inputs"><label>Silver pieces <input type="number" name="system.silver" value="{{system.silver}}"></label><label>Max Inventory ENC <input type="number" name="system.encumbranceMax" value="{{inventoryMax}}"></label><label>Max At Hand ENC <input type="number" min="0" name="system.weaponEncumbranceMax" value="{{weaponMax}}"></label></div>
{{#if inventoryExcess}}<p class="tbe-over">Inventory {{inventoryExcess}} ENC over maximum: {{inventoryOverflowPenalty}} to physical skill rolls.{{#if inventoryLimitExceeded}} The book does not allow carrying 10 or more ENC over the limit.{{/if}}</p>{{/if}}
    <h3>Penalties from worn armour <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Only the heavier leg piece’s Athletics penalty applies. Qualifying armour on the body, arms, or legs adds −30 when swimming; toggle this in the Athletics roll. Rise from Prone comes from body armour only. Edit each armour item to customise its penalties." data-tbe-tip="Only the heavier leg piece’s Athletics penalty applies. Qualifying armour on the body, arms, or legs adds −30 when swimming; toggle this in the Athletics roll. Rise from Prone comes from body armour only. Edit each armour item to customise its penalties.">i</span></h3><div class="tbe-armour-penalties">{{#each wornArmorPenalties as |row|}}<div title="{{row.sources}}"><b>{{row.label}}</b><span>{{row.value}}</span>{{#if row.sources}}<small>{{row.sources}}</small>{{/if}}</div>{{/each}}</div>
    <h3>Armour protection by location <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Assign each worn Armour Item a body location to place it here. Sundered armour provides 0 AP. Use the switch for the current hit; shield or secondary weapon AP is never part of worn armour. Move or remove any armour missing its body location in the Worn area below." data-tbe-tip="Assign each worn Armour Item a body location to place it here. Sundered armour provides 0 AP. Use the switch for the current hit; shield or secondary weapon AP is never part of worn armour. Move or remove any armour missing its body location in the Worn area below.">i</span></h3>
    <div class="tbe-defensive-ap"><h3>Defensive AP <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Select a shield held and ready or, with Two-Weapon Fighter, an eligible Light secondary weapon. Shield AP applies when the shield can protect; a split or pierced shield shows reduced AP. Secondary weapon AP applies against melee attacks, not ranged attacks, and needs a Light or Medium primary weapon. Circumvent Shield bypasses this AP. Defensive AP remains separate from worn armour." data-tbe-tip="Select a shield held and ready or, with Two-Weapon Fighter, an eligible Light secondary weapon. Shield AP applies when the shield can protect; a split or pierced shield shows reduced AP. Secondary weapon AP applies against melee attacks, not ranged attacks, and needs a Light or Medium primary weapon. Circumvent Shield bypasses this AP. Defensive AP remains separate from worn armour.">i</span></h3><div class="tbe-defensive-ap-fields"><label>Defensive item <select name="system.defensiveItemId" aria-label="Selected shield or secondary weapon"><option value="" {{#unless defensiveSource}}selected{{/unless}}>None</option>{{#each defensiveSources as |source|}}<option value="{{source.id}}" {{#if source.selected}}selected{{/if}}>{{source.name}} ({{source.kind}})</option>{{/each}}</select></label><div class="tbe-defensive-ap-value"><b>AP</b><strong>{{#if defensiveSource}}{{defensiveSource.ap}}{{else}}0{{/if}}</strong></div></div></div><button type="button" class="tbe-defense-switch" data-toggle-defensive-ap aria-pressed="{{applyDefensiveAP}}" {{#unless defensiveSource}}disabled{{/unless}}>Apply Defensive AP</button>
    <div class="tbe-armor-slots">{{#each armorSlots as |slot|}}<div class="tbe-armor-slot {{#if slot.conflict}}tbe-over{{/if}}"><b>{{slot.location}}</b><div class="tbe-location-ap"><span>Armour {{slot.protection}}</span><span>Defensive {{slot.defensive}}</span><strong>Total {{slot.totalProtection}} AP</strong></div>
      {{#each slot.items as |item|}}<div class="tbe-slot-item"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">{{item.name}}</button>{{#if item.system.sundered}}<span>Sundered</span>{{/if}}</div>{{/each}}
      {{#if slot.conflict}}<strong>More than one armour piece assigned here. Choose one to wear.</strong>{{/if}}
    </div>{{/each}}</div>
    {{#if unassignedArmor.length}}<p class="tbe-over">Worn armour missing a body location (shown in the Worn area below): {{#each unassignedArmor as |item|}}{{item.name}} {{/each}}</p>{{/if}}
    <button type="button" data-add-location>+ Equipment location</button>
    {{#each equipmentAreas as |area|}}<div class="tbe-inventory-area" data-drop-area="{{area.key}}"><h3><span class="tbe-area-drag" draggable="true" data-drag-area="{{area.key}}" role="img" aria-label="Drag to reorder {{area.title}}" title="Drag to reorder equipment locations">⠿</span><span class="tbe-area-heading">{{area.title}}</span>
      {{#if (eq area.key "atHand")}}<span class="tbe-area-metric {{#if @root.weaponOver}}tbe-over{{/if}}" title="Only At Hand weapons and shields count against this limit.">ENC <strong>{{@root.weaponENC}} / {{@root.weaponMax}}</strong></span>{{/if}}
      {{#if (eq area.key "ready")}}<span class="tbe-area-metric" title="Held and Ready weapons and shields have no ENC limit; this total is for reference.">ENC <strong>{{@root.heldReadyENC}} (no limit)</strong></span>{{/if}}
      {{#if (eq area.key "inventory")}}<span class="tbe-area-metric {{#if @root.inventoryOver}}tbe-over{{/if}}" title="Total Inventory ENC for all carried locations, including coins and stored armour; this is not just the items stored here.">Total carried ENC <strong>{{@root.inventoryENC}} / {{@root.inventoryMax}}</strong></span>{{/if}}
      {{#if (eq area.key "worn")}}<span class="tbe-area-metric" title="Worn armour Bulk; every 3 Bulk imposes an Initiative penalty.">Bulk <strong>{{@root.wornBulk}}</strong> · Initiative penalty <strong>−{{@root.armorInitiativePenalty}}</strong></span>{{/if}}
      {{#if area.custom}}<label class="tbe-location-count" title="Include this location in the character’s Inventory ENC">Count ENC <input type="checkbox" data-location-count="{{area.locationIndex}}" {{#if area.countsEncumbrance}}checked{{/if}}></label><button type="button" data-remove-location="{{area.locationIndex}}" aria-label="Delete location {{area.title}}" title="Delete equipment location">×</button>{{/if}}<button type="button" data-add="item" data-area="{{area.key}}">+ Item</button></h3><div class="tbe-equipment-cards">{{#each area.items as |item|}}
      <div class="tbe-equipment-card" draggable="true" data-item-id="{{item.id}}"><details class="tbe-equipment-details" data-equipment-details="{{item.id}}"><summary class="tbe-equipment-summary">{{item.name}}</summary><div class="tbe-equipment-title"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">Edit {{item.name}}</button><label class="tbe-item-qty">Qty <input type="number" min="0" step="1" data-item-quantity="{{item.id}}" value="{{item.system.quantity}}" aria-label="Quantity of {{item.name}}"></label><span>{{#if (eq item.type "armor")}}Armour{{else}}{{item.type}}{{/if}}</span><select aria-label="Where is {{item.name}}?" data-item-placement="{{item.id}}">{{#each (lookup @root.placementOptions item.type) as |choice|}}<option value="{{choice.value}}" {{#if (eq choice.value (lookup @root.itemPlacements item.id))}}selected{{/if}}>{{choice.label}}</option>{{/each}}</select><button type="button" aria-label="Remove {{item.name}}" data-delete-item="{{item.id}}">×</button></div>{{#if (eq area.key "dropped")}}<label class="tbe-item-zone">Zone <input type="text" data-item-zone="{{item.id}}" aria-label="Zone for {{item.name}}" value="{{lookup @root.itemZones item.id}}" placeholder="Which zone?"></label>{{/if}}
        {{#if (eq item.type "weapon")}}{{#with (lookup @root.weaponUses item.id) as |use|}}{{#if use.thrown}}<label class="tbe-use-mode">Use <select data-weapon-mode="{{item.id}}" aria-label="How to use {{item.name}}"><option value="melee" {{#unless use.isThrown}}selected{{/unless}}>Melee</option><option value="thrown" {{#if use.isThrown}}selected{{/if}}>Thrown</option></select></label>{{/if}}<div class="tbe-weapon-facts"><div><b>SP</b><span>{{item.system.price}}</span></div><div><b title="Weapon reach affects how combatants engage.">RCH</b><span>{{use.stats.reach}}</span></div><div><b title="Weapon base damage before other combat effects.">DMG</b><span>{{use.stats.damage}}</span></div><div><b title="Rolled success levels needed to choose the hit location.">CL</b><span>{{use.stats.chooseLocation}}</span></div><div><b title="Rolled success levels needed to circumvent a shield.">CS</b><span>{{use.stats.circumventShield}}</span></div><div><b title="Rolled success levels needed to disarm an opponent.">DIS</b><span>{{use.stats.disarm}}</span></div><div><b title="Rolled success levels needed to trip an opponent.">T</b><span>{{use.stats.trip}}</span></div><div><b title="Weapon encumbrance when carried.">ENC</b><span>{{use.stats.encumbrance}}</span></div><div><b title="Weapon range for ranged attacks.">RNG</b><span>{{use.stats.range}}</span></div></div>{{/with}}{{/if}}
        {{#if (eq item.type "shield")}}{{#if (lookup @root.pinnableShields item.id)}}<label class="tbe-check tbe-shield-pinned" title="Pierce Through: 4 SL with a thrown spear or javelin when the shield stops or reduces the attack. Shield AP −2 until the lodged weapon is removed with a Minor Action; further pins do not reduce AP again.">Pierced Through <input type="checkbox" data-pin-shield="{{item.id}}" {{#if item.system.pinned}}checked{{/if}}></label>{{/if}}<div class="tbe-weapon-facts"><div><b>Size</b><span>{{item.system.size}}</span></div><div><b>AP</b><span>{{lookup @root.shieldAP item.id}}{{#if item.system.split}} (split){{else}}{{#if item.system.pinned}} (Pierced Through){{/if}}{{/if}}</span></div><div><b>ShB</b><span>{{item.system.shieldBash}}</span></div><div><b title="Weapon encumbrance when carried.">ENC</b><span>{{item.system.encumbrance}}</span></div></div>{{/if}}
        {{#if (eq item.type "armor")}}<div class="tbe-weapon-facts"><div><b>AP</b><span>{{#if item.system.sundered}}0 (sundered){{else}}{{item.system.protection}}{{/if}}</span></div><div><b>Bulk when worn</b><span>{{item.system.bulk}}</span></div><div><b title="Encumbrance of carried equipment, including coins and stored armour.">Inventory ENC</b><span>1</span></div></div>{{/if}}
        {{#if (eq item.type "gear")}}<div class="tbe-weapon-facts"><div><b>ENC each</b><span>{{item.system.encumbrance}}</span></div><div><b>SP each</b><span>{{item.system.price}}</span></div></div>{{/if}}
        {{#if item.system.notes}}<div class="tbe-weapon-notes"><b>Notes</b><span>{{#each (lookup @root.itemNoteSegments item.id) as |part|}}{{#if part.tooltip}}<span class="tbe-note-term" tabindex="0" data-tbe-tip="{{part.tooltip}}">{{part.text}}</span>{{else}}{{part.text}}{{/if}}{{/each}}</span></div>{{/if}}
      </details>{{#if (eq item.type "weapon")}}{{#with (lookup @root.weaponUses item.id) as |use|}}{{#if (eq area.key "ready")}}<button type="button" class="tbe-equipment-attack" data-attack-item="{{item.id}}">Attack</button>{{/if}}{{#if (eq area.key "atHand")}}<button type="button" class="tbe-equipment-attack" data-attack-item="{{item.id}}">{{#if use.isThrown}}Throw{{else}}Draw &amp; attack{{/if}}</button>{{/if}}{{/with}}{{/if}}</div>{{/each}}</div></div>{{/each}}
  <h3>Supply Dice <span class="tbe-info" tabindex="0" role="img" aria-label="Information: Roll after using the relevant supply. A result of 1–2 reduces its die by one step; a depleted d6 runs out." data-tbe-tip="Roll after using the relevant supply. A result of 1–2 reduces its die by one step; a depleted d6 runs out.">i</span></h3><div class="tbe-grid tbe-supply-grid"><label>Gear <select name="system.supply.gear"><option value="d12" {{#if (eq supplyDisplay.gear "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.gear "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.gear "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.gear "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.gear "depleted")}}selected{{/if}}>Depleted</option></select><button type="button" data-roll-supply="gear" aria-label="Roll Gear Supply">Roll</button></label><label>Ammo <select name="system.supply.ammo"><option value="d12" {{#if (eq supplyDisplay.ammo "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.ammo "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.ammo "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.ammo "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.ammo "depleted")}}selected{{/if}}>Depleted</option></select><button type="button" data-roll-supply="ammo" aria-label="Roll Ammo Supply">Roll</button></label><label>Rations <select name="system.supply.rations"><option value="d12" {{#if (eq supplyDisplay.rations "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.rations "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.rations "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.rations "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.rations "depleted")}}selected{{/if}}>Depleted</option></select><button type="button" data-roll-supply="rations" aria-label="Roll Rations Supply">Roll</button></label><label>Medical <select name="system.supply.medical"><option value="d12" {{#if (eq supplyDisplay.medical "d12")}}selected{{/if}}>d12</option><option value="d10" {{#if (eq supplyDisplay.medical "d10")}}selected{{/if}}>d10</option><option value="d8" {{#if (eq supplyDisplay.medical "d8")}}selected{{/if}}>d8</option><option value="d6" {{#if (eq supplyDisplay.medical "d6")}}selected{{/if}}>d6</option><option value="depleted" {{#if (eq supplyDisplay.medical "depleted")}}selected{{/if}}>Depleted</option></select><button type="button" data-roll-supply="medical" aria-label="Roll Medical Supply">Roll</button></label></div>
  <h3>Notes</h3><textarea class="tbe-grow" rows="3" name="system.notes">{{system.notes}}</textarea></section>
  <section id="tbe-story"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="story" aria-label="Toggle Story" aria-expanded="true">▾</button>Story</h2><div class="tbe-grid">{{#each system.events as |event name|}}<div class="tbe-event"><h3>{{name}}</h3><label>Event <input name="system.events.{{name}}.name" value="{{event.name}}"></label><label>Benefit <input name="system.events.{{name}}.benefit" value="{{event.benefit}}"></label><label>Story <textarea class="tbe-grow" rows="2" name="system.events.{{name}}.story">{{event.story}}</textarea></label></div>{{/each}}</div>
  <h3>Shared histories <button type="button" data-add="sharedHistories">Add</button></h3><div class="tbe-list tbe-histories"><div class="tbe-list-heading"><span>Character</span><span>Event</span><span>Skill benefit</span><span>Story</span><span></span></div>{{#each system.sharedHistories as |row i|}}<div class="tbe-list-row"><input placeholder="Character" aria-label="Character" name="system.sharedHistories.{{i}}.character" value="{{row.character}}"><input placeholder="Event" aria-label="Event" name="system.sharedHistories.{{i}}.event" value="{{row.event}}"><input placeholder="Skill benefit" aria-label="Skill benefit" name="system.sharedHistories.{{i}}.skill" value="{{row.skill}}"><textarea class="tbe-grow" rows="1" placeholder="Story" aria-label="Story" name="system.sharedHistories.{{i}}.story">{{row.story}}</textarea><button type="button" aria-label="Delete shared history" title="Delete shared history" data-remove="sharedHistories:{{i}}">×</button></div>{{/each}}</div>
  <h3>Relationship NPCs <button type="button" data-add="relationships">Add</button></h3><div class="tbe-list tbe-relationships"><div class="tbe-list-heading"><span>Name</span><span>Relationship</span><span>Notes</span><span></span></div>{{#each system.relationships as |row i|}}<div class="tbe-list-row"><input placeholder="Name" aria-label="Name" name="system.relationships.{{i}}.name" value="{{row.name}}"><input placeholder="Friend, Patron, Rival, Adversary" aria-label="Relationship" name="system.relationships.{{i}}.type" value="{{row.type}}"><textarea class="tbe-grow" rows="1" placeholder="Notes" aria-label="Notes" name="system.relationships.{{i}}.notes">{{row.notes}}</textarea><button type="button" aria-label="Delete relationship NPC" title="Delete relationship NPC" data-remove="relationships:{{i}}">×</button></div>{{/each}}</div>
  <h3>Personality traits <button type="button" data-add="personalityTraits">Add</button></h3><div class="tbe-list tbe-traits"><div class="tbe-list-heading"><span>Trait</span><span>Description</span><span></span></div>{{#each system.personalityTraits as |row i|}}<div class="tbe-list-row"><input placeholder="Trait" aria-label="Trait" name="system.personalityTraits.{{i}}.name" value="{{row.name}}"><textarea class="tbe-grow" rows="1" placeholder="Description" aria-label="Description" name="system.personalityTraits.{{i}}.description">{{row.description}}</textarea><button type="button" aria-label="Delete personality trait" title="Delete personality trait" data-remove="personalityTraits:{{i}}">×</button></div>{{/each}}</div>
  <h3>Goals <button type="button" data-add="goals">Add goal</button></h3><div class="tbe-list tbe-goals"><div class="tbe-list-heading"><span>Goal</span><span>Shared</span><span></span></div>{{#each system.goals as |row i|}}<div class="tbe-list-row"><textarea class="tbe-grow" rows="1" placeholder="Goal" aria-label="Goal" name="system.goals.{{i}}.text">{{row.text}}</textarea><label class="tbe-check"><input aria-label="Shared" type="checkbox" name="system.goals.{{i}}.shared" {{#if row.shared}}checked{{/if}}></label><button type="button" aria-label="Delete goal" title="Delete goal" data-remove="goals:{{i}}">×</button></div>{{/each}}</div></section>
  <section id="tbe-reference"><h2><button type="button" class="tbe-collapse-toggle" data-collapse-section="reference" aria-label="Toggle Reference" aria-expanded="true">▾</button>Reference</h2>

  <h3>Manoeuvres <span class="tbe-info" tabindex="0" role="img" aria-label="Information: After winning an opposed attack, select one manoeuvre using the attacker&#x27;s rolled SLs, including Expertise and critical bonuses. The defender&#x27;s SLs affect DoS and damage. Most manoeuvres do not spend SLs; Cleave Shield uses DoS. A critical attack may choose two. Check armour training and other requirements." data-tbe-tip="After winning an opposed attack, select one manoeuvre using the attacker&#x27;s rolled SLs, including Expertise and critical bonuses. The defender&#x27;s SLs affect DoS and damage. Most manoeuvres do not spend SLs; Cleave Shield uses DoS. A critical attack may choose two. Check armour training and other requirements.">i</span></h3><div class="tbe-reference-grid">{{#each maneuvers as |move|}}<details><summary><strong>{{move.name}}</strong><span>{{move.cost}}</span></summary><p>{{move.effect}}</p></details>{{/each}}</div>
  <h3>Common modifiers</h3><div class="tbe-reference-grid">{{#each combatModifiers as |mod|}}<details><summary><strong>{{mod.name}}</strong><span>{{mod.value}}</span></summary><p>{{mod.note}}</p></details>{{/each}}</div>
  <h3>Turn reminders <span class="tbe-info tbe-tip-up" tabindex="0" role="img" aria-label="Information: One action and one move per turn. Drawing and attacking with an At Hand weapon is −20; retrieving an Inventory Item takes two actions and it can be used on the third. Aim, Charge, Set for Charge, Stand Your Ground, Fighting Withdrawal and Flee have further requirements in Chapter 10." data-tbe-tip="One action and one move per turn. Drawing and attacking with an At Hand weapon is −20; retrieving an Inventory Item takes two actions and it can be used on the third. Aim, Charge, Set for Charge, Stand Your Ground, Fighting Withdrawal and Flee have further requirements in Chapter 10.">i</span></h3></section>

</div>
