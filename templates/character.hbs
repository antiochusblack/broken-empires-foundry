<div class="tbe-sheet-body">
  <header class="tbe-header"><img src="{{document.img}}" alt="{{document.name}}" width="72" height="72"><label>Character name <input name="name" value="{{document.name}}"></label><label>Concept <input name="system.description" value="{{system.description}}"></label></header>
  <nav class="tbe-nav"><a href="#tbe-identity">Identity</a><a href="#tbe-skills">Skills</a><a href="#tbe-magic">Magic</a><a href="#tbe-combat">Combat</a><a href="#tbe-story">Story</a><a href="#tbe-gear">Gear</a></nav>
  <section id="tbe-identity"><h2>Identity & creation</h2><div class="tbe-grid">
    <label>Race <input name="system.race" value="{{system.race}}"></label><label>Sex <input name="system.sex" value="{{system.sex}}"></label><label>Size <input name="system.size" value="{{system.size}}"></label><label>Age <input name="system.age" value="{{system.age}}"></label>
    <label>Culture <input name="system.culture" value="{{system.culture}}"></label><label>Previous career <input name="system.career" value="{{system.career}}"></label><label>Status <input type="number" name="system.status" value="{{system.status}}"></label><label>XP <input type="number" name="system.xp" value="{{system.xp}}"></label>
  </div>
  <h3>Ability scores & descriptors <button type="button" data-add="abilityScores">Add</button></h3>{{#each system.abilityScores as |row i|}}<div class="tbe-row"><input aria-label="Ability score" placeholder="STR, DEX, CON, INT, WIS or CHA" name="system.abilityScores.{{i}}.name" value="{{row.name}}"><input aria-label="Descriptor" placeholder="Descriptor" name="system.abilityScores.{{i}}.descriptor" value="{{row.descriptor}}"><button type="button" data-remove="abilityScores:{{i}}">Remove</button></div>{{/each}}
  <h3>Race traits <button type="button" data-add="racialTraits">Add</button></h3>{{#each system.racialTraits as |row i|}}<div class="tbe-row"><input aria-label="Trait" placeholder="Trait" name="system.racialTraits.{{i}}.name" value="{{row.name}}"><input aria-label="Effect" placeholder="Effect" name="system.racialTraits.{{i}}.effect" value="{{row.effect}}"><button type="button" data-remove="racialTraits:{{i}}">Remove</button></div>{{/each}}
  </section>
  <section id="tbe-skills"><h2>Skills</h2><p>Edit values directly after making your character creation choices. Ex is Expertise; S marks Savvy.</p>
  {{#each skillGroups as |group|}}{{#unless (eq group.category "Strands")}}{{#unless (eq group.category "Binds")}}{{#unless (eq group.category "Magic")}}<h3>{{group.category}}</h3><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span>{{row.name}}</span><input aria-label="{{row.name}} percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><input aria-label="{{row.name}} Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"><label class="tbe-check">S <input type="checkbox" name="{{row.path}}.savvy" {{#if row.data.savvy}}checked{{/if}}></label></div>{{/each}}</div>{{/unless}}{{/unless}}{{/unless}}{{/each}}
  <h3>Languages, custom -wise and other skills <button type="button" data-add="customSkills">Add custom skill</button></h3><div class="tbe-skill-list">{{#each system.customSkills as |row i|}}<div class="tbe-skill tbe-custom"><input aria-label="Skill name" placeholder="Skill name" name="system.customSkills.{{i}}.name" value="{{row.name}}"><input aria-label="Category" placeholder="Category" name="system.customSkills.{{i}}.category" value="{{row.category}}"><input aria-label="Percent" type="number" name="system.customSkills.{{i}}.value" value="{{row.value}}"><input aria-label="Expertise" type="number" name="system.customSkills.{{i}}.expertise" value="{{row.expertise}}"><label class="tbe-check">S <input type="checkbox" name="system.customSkills.{{i}}.savvy" {{#if row.savvy}}checked{{/if}}></label><button type="button" data-remove="customSkills:{{i}}">×</button></div>{{/each}}</div></section>
  <section id="tbe-magic"><h2>Magic</h2>{{#each skillGroups as |group|}}{{#if (eq group.category "Binds")}}<h3>Binds</h3><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span>{{row.name}}</span><input aria-label="{{row.name}} percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><input aria-label="{{row.name}} Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"><label class="tbe-check">S <input type="checkbox" name="{{row.path}}.savvy" {{#if row.data.savvy}}checked{{/if}}></label></div>{{/each}}</div>{{/if}}
  {{#if (eq group.category "Magic")}}<h3>Piety</h3><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span>{{row.name}}</span><input aria-label="Piety percent" type="number" name="{{row.path}}.value" value="{{row.data.value}}"><input aria-label="Piety Expertise" type="number" name="{{row.path}}.expertise" value="{{row.data.expertise}}"></div>{{/each}}</div>{{/if}}
  {{#if (eq group.category "Strands")}}<h3>Strands</h3><div class="tbe-skill-list">{{#each group.rows as |row|}}<div class="tbe-skill"><span>{{row.name}}</span><input aria-label="{{row.name}} level" type="number" name="{{row.path}}.level" value="{{row.data.level}}"><label class="tbe-check">Thin <input type="checkbox" name="{{row.path}}.thin" {{#if row.data.thin}}checked{{/if}}></label></div>{{/each}}</div>{{/if}}{{/each}}
  <div class="tbe-grid"><label>True Name <input name="system.trueName" value="{{system.trueName}}"></label><label>Threads <input name="system.threads" value="{{system.threads}}"></label><label>Fraying <input type="number" name="system.fraying" value="{{system.fraying}}"></label></div></section>
  <section id="tbe-combat"><h2>Resolve, fatigue & attributes</h2><div class="tbe-grid">
  <label>Current Resolve <input type="number" name="system.resolve.value" value="{{system.resolve.value}}"></label><label>Maximum Resolve <input type="number" name="system.resolve.max" value="{{system.resolve.max}}"></label><label>Fatigue <input type="number" name="system.resolve.fatigue" value="{{system.resolve.fatigue}}"></label><label>Permanent fatigue <input type="number" name="system.resolve.permanentFatigue" value="{{system.resolve.permanentFatigue}}"></label>
  <label>Initiative <input type="number" name="system.attributes.initiative" value="{{system.attributes.initiative}}"></label><label>Initiative penalty <input type="number" name="system.attributes.initiativePenalty" value="{{system.attributes.initiativePenalty}}"></label><label>Toughness <input type="number" name="system.attributes.toughness" value="{{system.attributes.toughness}}"></label><label>Death Threshold <input type="number" name="system.attributes.deathThreshold" value="{{system.attributes.deathThreshold}}"></label><label>Lethality Level <input type="number" name="system.attributes.lethalityLevel" value="{{system.attributes.lethalityLevel}}"></label></div>
  <h3>Wounds <button type="button" data-add="wounds">Add wound</button></h3><p>Mark ritual cuts separately from ordinary wounds. Record location, Wound Points and infection here.</p>{{#each system.wounds as |row i|}}<div class="tbe-row tbe-wound"><input placeholder="Location" aria-label="Location" name="system.wounds.{{i}}.location" value="{{row.location}}"><input placeholder="Description" aria-label="Description" name="system.wounds.{{i}}.detail" value="{{row.detail}}"><input aria-label="Wound Points" type="number" name="system.wounds.{{i}}.points" value="{{row.points}}"><label class="tbe-check">Lethal <input type="checkbox" name="system.wounds.{{i}}.lethal" {{#if row.lethal}}checked{{/if}}></label><label class="tbe-check">Ritual <input type="checkbox" name="system.wounds.{{i}}.ritual" {{#if row.ritual}}checked{{/if}}></label><label class="tbe-check">Infected <input type="checkbox" name="system.wounds.{{i}}.infection" {{#if row.infection}}checked{{/if}}></label><button type="button" data-remove="wounds:{{i}}">×</button></div>{{/each}}
  <h3>Custom resources <button type="button" data-add="resources">Add resource</button></h3>{{#each system.resources as |row i|}}<div class="tbe-row"><input placeholder="Resource name" aria-label="Resource name" name="system.resources.{{i}}.name" value="{{row.name}}"><input aria-label="Current" type="number" name="system.resources.{{i}}.value" value="{{row.value}}"><span>/</span><input aria-label="Maximum" type="number" name="system.resources.{{i}}.max" value="{{row.max}}"><button type="button" data-remove="resources:{{i}}">×</button></div>{{/each}}
  <h3>Talents <button type="button" data-add="talent">Add talent</button></h3><p>Click a talent to edit its source and effect. You can also drop a Talent Item onto this sheet.</p>{{#each talents as |item|}}<div class="tbe-row"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">{{item.name}}</button><span>{{item.system.source}}</span><span>{{item.system.effect}}</span><button type="button" data-delete-item="{{item.id}}">×</button></div>{{/each}}
  </section>
  <section id="tbe-story"><h2>Life events</h2><div class="tbe-grid">{{#each system.events as |event name|}}<div class="tbe-event"><h3>{{name}}</h3><label>Event <input name="system.events.{{name}}.name" value="{{event.name}}"></label><label>Benefit <input name="system.events.{{name}}.benefit" value="{{event.benefit}}"></label><label>Story <textarea name="system.events.{{name}}.story">{{event.story}}</textarea></label></div>{{/each}}</div>
  <h3>Shared histories <button type="button" data-add="sharedHistories">Add</button></h3>{{#each system.sharedHistories as |row i|}}<div class="tbe-row"><input placeholder="Character" aria-label="Character" name="system.sharedHistories.{{i}}.character" value="{{row.character}}"><input placeholder="Event" aria-label="Event" name="system.sharedHistories.{{i}}.event" value="{{row.event}}"><input placeholder="Skill benefit" aria-label="Skill benefit" name="system.sharedHistories.{{i}}.skill" value="{{row.skill}}"><input placeholder="Story" aria-label="Story" name="system.sharedHistories.{{i}}.story" value="{{row.story}}"><button type="button" data-remove="sharedHistories:{{i}}">×</button></div>{{/each}}
  <h3>Relationship NPCs <button type="button" data-add="relationships">Add</button></h3>{{#each system.relationships as |row i|}}<div class="tbe-row"><input placeholder="Name" aria-label="Name" name="system.relationships.{{i}}.name" value="{{row.name}}"><input placeholder="Friend, Patron, Rival, Adversary" aria-label="Relationship" name="system.relationships.{{i}}.type" value="{{row.type}}"><input placeholder="Notes" aria-label="Notes" name="system.relationships.{{i}}.notes" value="{{row.notes}}"><button type="button" data-remove="relationships:{{i}}">×</button></div>{{/each}}
  <h3>Personality traits <button type="button" data-add="personalityTraits">Add</button></h3>{{#each system.personalityTraits as |row i|}}<div class="tbe-row"><input placeholder="Trait" aria-label="Trait" name="system.personalityTraits.{{i}}.name" value="{{row.name}}"><input placeholder="Description" aria-label="Description" name="system.personalityTraits.{{i}}.description" value="{{row.description}}"><button type="button" data-remove="personalityTraits:{{i}}">×</button></div>{{/each}}
  <h3>Goals <button type="button" data-add="goals">Add goal</button></h3>{{#each system.goals as |row i|}}<div class="tbe-row"><input placeholder="Goal" aria-label="Goal" name="system.goals.{{i}}.text" value="{{row.text}}"><label class="tbe-check">Shared <input type="checkbox" name="system.goals.{{i}}.shared" {{#if row.shared}}checked{{/if}}></label><button type="button" data-remove="goals:{{i}}">×</button></div>{{/each}}</section>
  <section id="tbe-gear"><h2>Equipment</h2><div class="tbe-grid"><label>Silver pieces <input type="number" name="system.silver" value="{{system.silver}}"></label><label>Maximum ENC <input type="number" name="system.encumbranceMax" value="{{system.encumbranceMax}}"></label></div>
  <h3>Weapons <button type="button" data-add="weapon">Add weapon</button></h3>{{#each weapons as |item|}}<div class="tbe-row"><button type="button" class="tbe-item-link" data-open-item="{{item.id}}">{{item.name}}</button><span>Damage: {{item.system.damage}}</span><span>ENC: {{item.system.encumbrance}}</span><button type="button" data-delete-item="{{item.id}}">×</button></div>{{/each}}
  <h3>Armor <button type="button" data-add="armor">Add armor</button></h3>{{#each system.armor as |row i|}}<div class="tbe-row"><input placeholder="Location" aria-label="Location" name="system.armor.{{i}}.location" value="{{row.location}}"><input placeholder="Armor" aria-label="Armor" name="system.armor.{{i}}.name" value="{{row.name}}"><input aria-label="AP" title="AP" type="number" name="system.armor.{{i}}.protection" value="{{row.protection}}"><input aria-label="Bulk" title="Bulk" type="number" name="system.armor.{{i}}.bulk" value="{{row.bulk}}"><input placeholder="Notes" aria-label="Notes" name="system.armor.{{i}}.notes" value="{{row.notes}}"><button type="button" data-remove="armor:{{i}}">×</button></div>{{/each}}
  <h3>Inventory <button type="button" data-add="equipment">Add equipment</button></h3>{{#each system.equipment as |row i|}}<div class="tbe-row"><input placeholder="Item" aria-label="Item" name="system.equipment.{{i}}.name" value="{{row.name}}"><input aria-label="Quantity" title="Quantity" type="number" name="system.equipment.{{i}}.quantity" value="{{row.quantity}}"><input aria-label="ENC" title="ENC" type="number" name="system.equipment.{{i}}.encumbrance" value="{{row.encumbrance}}"><input placeholder="Notes" aria-label="Notes" name="system.equipment.{{i}}.notes" value="{{row.notes}}"><button type="button" data-remove="equipment:{{i}}">×</button></div>{{/each}}
  <h3>Supply dice</h3><div class="tbe-grid"><label>Gear <input name="system.supply.gear" value="{{system.supply.gear}}" placeholder="d12"></label><label>Ammo <input name="system.supply.ammo" value="{{system.supply.ammo}}" placeholder="d12"></label><label>Rations <input name="system.supply.rations" value="{{system.supply.rations}}" placeholder="d12"></label><label>Medical <input name="system.supply.medical" value="{{system.supply.medical}}" placeholder="d12"></label></div>
  <h3>Notes</h3><textarea name="system.notes">{{system.notes}}</textarea></section>
</div>
