<div class="tbe-sheet-body">
  <label>Name <input name="name" type="text" value="{{document.name}}"></label>
  {{#if (eq document.type "talent")}}
    <label>Source (how gained) <input name="system.source" type="text" value="{{system.source}}"></label>
    <label>Effect <textarea class="tbe-grow" rows="2" name="system.effect">{{system.effect}}</textarea></label>
    <label>Requirements <textarea class="tbe-grow" rows="2" name="system.requirements">{{system.requirements}}</textarea></label>
  {{else}}
    {{#if owned}}
      <label>Where is it?
        <select name="system.placement">{{#each placements as |choice|}}<option value="{{choice.value}}" {{#if (eq choice.value ../system.placement)}}selected{{/if}}>{{choice.label}}</option>{{/each}}</select>
      </label>
    {{/if}}
    {{#if (eq document.type "weapon")}}
      <p>Attack and Parry use the character’s skills. Manoeuvre values are required Success Levels.</p>
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>Reach (RCH) <input name="system.reach" value="{{system.reach}}"></label>
        <label>Base damage (DMG) <input name="system.damage" value="{{system.damage}}"></label><label>Choose Location (CL) <input name="system.chooseLocation" value="{{system.chooseLocation}}"></label>
        <label>Circumvent Shield (CS) <input name="system.circumventShield" value="{{system.circumventShield}}"></label><label>Disarm (DIS) <input name="system.disarm" value="{{system.disarm}}"></label>
        <label>Trip (T) <input name="system.trip" value="{{system.trip}}"></label><label>Weapon ENC <input name="system.encumbrance" type="number" value="{{system.encumbrance}}"></label>
        <label>Range (RNG) <input name="system.range" value="{{system.range}}"></label>
        <label class="tbe-check">One copy At Hand has no ENC <input type="checkbox" name="system.freeAtHand" {{#if system.freeAtHand}}checked{{/if}}></label>
      </div>
    {{/if}}
    {{#if (eq document.type "armor")}}
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>Armour Points (AP) <input name="system.protection" type="number" value="{{system.protection}}"></label>
        <label>Bulk per piece <input name="system.bulk" type="number" step="0.5" min="0" value="{{system.bulk}}"></label>
        <label>Body location for this armour piece <select name="system.location"><option value="">Choose location</option>{{#each locations as |location|}}<option value="{{location}}" {{#if (eq location ../system.location)}}selected{{/if}}>{{location}}</option>{{/each}}</select></label>
        <label class="tbe-check">Requires armour training <input type="checkbox" name="system.training" {{#if system.training}}checked{{/if}}></label>
        <label class="tbe-check">Can be sundered <input type="checkbox" name="system.canSunder" {{#if system.canSunder}}checked{{/if}}></label>
        {{#if owned}}<label class="tbe-check">Currently sundered <input type="checkbox" name="system.sundered" {{#if system.sundered}}checked{{/if}}></label>{{/if}}
      </div>
      <label>Armour skill penalties <textarea class="tbe-grow" rows="2" name="system.penalties">{{system.penalties}}</textarea></label>
      <p>Only one armour piece can protect each location. Carried armour costs 1 Inventory ENC per piece.</p>
    {{/if}}
    {{#if (eq document.type "shield")}}
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>Size <input name="system.size" value="{{system.size}}" placeholder="Buckler, Small, Medium, Large"></label>
        <label>Armour Points (AP) <input name="system.protection" type="number" value="{{system.protection}}"></label><label>Shield Bash SL (ShB) <input name="system.shieldBash" value="{{system.shieldBash}}"></label>
        <label>Weapon ENC <input name="system.encumbrance" type="number" value="{{system.encumbrance}}"></label>
        {{#if owned}}<label class="tbe-check">Split (broken) <input type="checkbox" name="system.split" {{#if system.split}}checked{{/if}}></label>{{/if}}
      </div>
    {{/if}}
    {{#if (eq document.type "gear")}}
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>ENC each <input name="system.encumbrance" type="number" step="0.5" min="0" value="{{system.encumbrance}}"></label>
        {{#if owned}}<label>Quantity <input name="system.quantity" type="number" min="0" value="{{system.quantity}}"></label>{{/if}}
      </div>
    {{/if}}
    <label>Notes <textarea class="tbe-grow" rows="2" name="system.notes">{{system.notes}}</textarea></label>
  {{/if}}
</div>
