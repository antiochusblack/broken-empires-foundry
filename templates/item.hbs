<div class="tbe-sheet-body">
  <label>Name <input name="name" type="text" value="{{document.name}}"></label>
  {{#if (eq document.type "thread")}}
    <label>Description <textarea class="tbe-grow" rows="2" name="system.description">{{system.description}}</textarea></label>
    <div class="tbe-grid"><label>Track as <select name="system.useMode"><option value="die" {{#if (eq system.useMode "die")}}selected{{/if}}>Thread die</option><option value="points" {{#if (eq system.useMode "points")}}selected{{/if}}>Consumable points</option></select></label>
      <label>Thread die <select name="system.die">{{#each threadDice as |die|}}<option value="{{die}}" {{#if (eq die ../system.die)}}selected{{/if}}>{{die}}</option>{{/each}}</select></label>
      <label>Points remaining <input name="system.points" type="number" min="0" step="1" value="{{system.points}}"></label></div>
    <label>Applicable Binds and Strands <textarea class="tbe-grow" rows="3" name="system.bindsAndStrands">{{system.bindsAndStrands}}</textarea></label>
  {{else}}
  {{#if (eq document.type "talent")}}
    <label>Book category <input name="system.category" type="text" value="{{system.category}}"></label>
    <label>Rules reference <input name="system.reference" type="text" value="{{system.reference}}"></label>
    <label>Source (how gained) <input name="system.source" type="text" value="{{system.source}}"></label>
    <label>Effect <textarea class="tbe-grow" rows="2" name="system.effect">{{system.effect}}</textarea></label>
    <label>Requirements <textarea class="tbe-grow" rows="2" name="system.requirements">{{system.requirements}}</textarea></label>
    {{#if riseFighter}}<label>Rise a Fighter chosen skill <select name="system.riseSkill"><option value="">Choose skill</option>{{#each riseSkills as |name|}}<option value="{{name}}" {{#if (eq name ../system.riseSkill)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
  {{else}}
    {{#if (eq document.type "race")}}
      <p>Drag this Race item onto a character to fill their Race Traits.</p>
      {{#each system.traits as |trait|}}<div class="tbe-race-trait"><strong>{{trait.name}}</strong><p>{{trait.effect}}</p></div>{{/each}}
      <label>Notes <textarea class="tbe-grow" name="system.notes">{{system.notes}}</textarea></label>
    {{else}}
    {{#if owned}}
      <label>Where is it?
        <select name="system.placement">{{#each placements as |choice|}}<option value="{{choice.value}}" {{#if (eq choice.value ../system.placement)}}selected{{/if}}>{{choice.label}}</option>{{/each}}</select>
      </label>
    {{/if}}
    {{#unless (eq document.type "talent")}}<div class="tbe-grid">
      <label>Size <select name="system.size"><option value="">Choose size</option>{{#if (eq document.type "shield")}}<option value="Buckler" {{#if (eq system.size "Buckler")}}selected{{/if}}>Buckler</option>{{/if}}{{#each itemSizes as |size|}}<option value="{{size}}" {{#if (eq size ../system.size)}}selected{{/if}}>{{size}}</option>{{/each}}</select></label>
      {{#if owned}}<label>Quantity <input name="system.quantity" type="number" min="0" step="1" value="{{system.quantity}}"></label>{{/if}}
    </div>{{/unless}}
    {{#if (eq document.type "weapon")}}
      <p>Attack and Parry use the character’s skills. Manoeuvre values are required Success Levels.</p>
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>Book category <input name="system.category" value="{{system.category}}"></label>
        <label>Attack skill <select name="system.attackSkill"><option value="">Choose when attacking</option>{{#each attackSkills as |name|}}<option value="{{name}}" {{#if (eq name ../system.attackSkill)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Reach (RCH) <input name="system.reach" value="{{system.reach}}"></label>
        <label>Base damage (DMG) <input name="system.damage" value="{{system.damage}}"></label><label>Choose Location (CL) <input name="system.chooseLocation" value="{{system.chooseLocation}}"></label>
        <label>Circumvent Shield (CS) <input name="system.circumventShield" value="{{system.circumventShield}}"></label><label>Disarm (DIS) <input name="system.disarm" value="{{system.disarm}}"></label>
        <label>Trip (T) <input name="system.trip" value="{{system.trip}}"></label><label>Weapon ENC <input name="system.encumbrance" type="number" value="{{system.encumbrance}}"></label>
        <label>Range (RNG) <input name="system.range" value="{{system.range}}"></label>
        <label class="tbe-check">One copy At Hand has no ENC <input type="checkbox" name="system.freeAtHand" {{#if system.freeAtHand}}checked{{/if}}></label>
      </div>
      <details><summary>Thrown use (optional)</summary><p>Fill in a thrown attack skill to enable a Melee / Thrown switch on the character sheet. Blank thrown fields keep the melee value.</p><div class="tbe-grid">
        <label>Thrown attack skill <select name="system.thrown.attackSkill"><option value="">No thrown use</option>{{#each attackSkills as |name|}}<option value="{{name}}" {{#if (eq name ../system.thrown.attackSkill)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        <label>Thrown reach <input name="system.thrown.reach" value="{{system.thrown.reach}}"></label>
        <label>Thrown damage <input name="system.thrown.damage" value="{{system.thrown.damage}}"></label>
        <label>Thrown CL <input name="system.thrown.chooseLocation" value="{{system.thrown.chooseLocation}}"></label>
        <label>Thrown CS <input name="system.thrown.circumventShield" value="{{system.thrown.circumventShield}}"></label>
        <label>Thrown DIS <input name="system.thrown.disarm" value="{{system.thrown.disarm}}"></label>
        <label>Thrown trip <input name="system.thrown.trip" value="{{system.thrown.trip}}"></label>
        <label>Thrown range <input name="system.thrown.range" value="{{system.thrown.range}}"></label>
        <label>Thrown notes <input name="system.thrown.notes" value="{{system.thrown.notes}}"></label>
      </div></details>
    {{/if}}
    {{#if (eq document.type "armor")}}
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>Book category <input name="system.category" value="{{system.category}}"></label><label>Armour Points (AP) <input name="system.protection" type="number" value="{{system.protection}}"></label>
        <label>Bulk per piece <input name="system.bulk" type="number" step="0.5" min="0" value="{{system.bulk}}"></label>
        <label>Body location for this armour piece <select name="system.location"><option value="">Choose location</option>{{#each locations as |location|}}<option value="{{location}}" {{#if (eq location ../system.location)}}selected{{/if}}>{{location}}</option>{{/each}}</select></label>
        <label class="tbe-check">Requires armour training <input type="checkbox" name="system.training" {{#if system.training}}checked{{/if}}></label>
        <label class="tbe-check">Can be sundered <input type="checkbox" name="system.canSunder" {{#if system.canSunder}}checked{{/if}}></label>
        {{#if owned}}<label class="tbe-check">Currently sundered <input type="checkbox" name="system.sundered" {{#if system.sundered}}checked{{/if}}></label>{{/if}}
      </div>
      <h3>Penalties when worn</h3><p>Enter negative values, such as −10. Only penalties appropriate to this piece’s body location apply.</p>
      <div class="tbe-grid"><label>Stealth (body) <input type="number" name="system.stealthPenalty" value="{{penaltyFields.stealthPenalty}}"></label><label>Dodge (body) <input type="number" name="system.dodgePenalty" value="{{penaltyFields.dodgePenalty}}"></label><label>Rise from Prone (body) <input type="number" name="system.riseFromPronePenalty" value="{{penaltyFields.riseFromPronePenalty}}"></label><label>Athletics (legs) <input type="number" name="system.athleticsPenalty" value="{{penaltyFields.athleticsPenalty}}"></label><label>Perception (head) <input type="number" name="system.perceptionPenalty" value="{{penaltyFields.perceptionPenalty}}"></label></div>
      <p>Only one armour piece can protect each location. Carried armour costs 1 Inventory ENC per piece.</p>
    {{/if}}
    {{#if (eq document.type "shield")}}
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label>
        <label>Armour Points (AP) <input name="system.protection" type="number" value="{{system.protection}}"></label><label>Shield Bash SL (ShB) <input name="system.shieldBash" value="{{system.shieldBash}}"></label>
        <label>Weapon ENC <input name="system.encumbrance" type="number" value="{{system.encumbrance}}"></label>
        {{#if owned}}<label class="tbe-check">Split (broken) <input type="checkbox" name="system.split" {{#if system.split}}checked{{/if}}></label>{{#if pinnableShield}}<label class="tbe-check" title="Pierce Through: 4 SL with a thrown spear or javelin when shield AP stops or reduces the attack. −2 shield AP until removed with a Minor Action; does not stack.">Pierced Through <input type="checkbox" name="system.pinned" {{#if system.pinned}}checked{{/if}}></label>{{/if}}{{/if}}
      </div>
    {{/if}}
    {{#if (eq document.type "gear")}}
      <div class="tbe-grid">
        <label>Cost (sp) <input name="system.price" type="number" value="{{system.price}}"></label><label>Book category <input name="system.category" value="{{system.category}}"></label><label>ENC each <input name="system.encumbrance" type="number" step="0.5" min="0" value="{{system.encumbrance}}"></label>

      </div>
    {{/if}}
    <label>Notes <textarea class="tbe-grow" rows="2" name="system.notes">{{system.notes}}</textarea></label>
    {{#if (eq document.type "weapon")}}<div class="tbe-note-preview" aria-label="Weapon notes with rule explanations">{{#each noteSegments as |part|}}{{#if part.tooltip}}<span class="tbe-note-term" tabindex="0" data-tbe-tip="{{part.tooltip}}">{{part.text}}</span>{{else}}{{part.text}}{{/if}}{{/each}}</div>{{/if}}
    {{#if (eq document.type "armor")}}<div class="tbe-note-preview" aria-label="Armour notes with rule explanations">{{#each noteSegments as |part|}}{{#if part.tooltip}}<span class="tbe-note-term" tabindex="0" data-tbe-tip="{{part.tooltip}}">{{part.text}}</span>{{else}}{{part.text}}{{/if}}{{/each}}</div>{{/if}}
    {{/if}}
  {{/if}}
  {{/if}}
</div>
